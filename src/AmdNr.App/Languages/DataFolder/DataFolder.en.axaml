<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- The data folder card in Settings, its move, and the question a start asks when the folder is missing.
       In a file of its own beside Strings.en.axaml, which merges it. Every DataFolder.*.axaml has these keys,
       in this order. -->

  <sys:String x:Key="Str.DataFolderTitle">Installer data folder</sys:String>
  <sys:String x:Key="Str.DataFolderHint">Settings, the game list, downloads and logs. Games with NR installed do not use it, so moving it changes nothing in them.</sys:String>
  <sys:String x:Key="Str.DataFolderChange">Change…</sys:String>
  <sys:String x:Key="Str.DataFolderDefault">Back to default</sys:String>
  <sys:String x:Key="Str.DataFolderPick">Pick where the installer keeps its data</sys:String>
  <sys:String x:Key="Str.DataFolderNrLive">Close NRLive first: it runs from the data folder.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveTitle">Move the data folder</sys:String>
  <sys:String x:Key="Str.DataFolderMoveBody">To {0}. The installer restarts when it is done.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAll">Move everything</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAllBody">{0}, downloads included. Nothing has to be downloaded again.</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmpty">Start with an empty cache</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmptyBody">Moves settings, the game list, logs and your runtimes ({0}). Downloads are deleted and come back when a game needs them.</sys:String>
  <sys:String x:Key="Str.DataFolderKeepBody">Nothing moves.</sys:String>
  <sys:String x:Key="Str.DataFolderMoving">Moving… {0}%</sys:String>
  <sys:String x:Key="Str.DataFolderMoveFailed">The move did not finish ({0}). Nothing changed; the data is still in {1}.</sys:String>
  <sys:String x:Key="Str.DataFolderNested">That folder overlaps the installer's own data folder. Pick another one.</sys:String>
  <sys:String x:Key="Str.DataFolderSystem">Not inside Program Files or Windows. Pick another folder.</sys:String>
  <sys:String x:Key="Str.DataFolderGame">That folder is inside {0}, a game in your list. Pick another one.</sys:String>
  <sys:String x:Key="Str.DataFolderNotEmpty">{0} already has files in it. Pick an empty folder.</sys:String>
  <sys:String x:Key="Str.DataFolderNotWritable">Cannot write to {0}. Pick another folder.</sys:String>
  <sys:String x:Key="Str.DataFolderNoSpace">Not enough room there: the move needs {0} and the drive has {1} free.</sys:String>
  <sys:String x:Key="Str.DataMissingTitle">Data folder not found</sys:String>
  <sys:String x:Key="Str.DataMissingBody">The installer keeps its data in {0}, and that folder is not there. If it is on a drive that is unplugged, plug it in and try again.</sys:String>
  <sys:String x:Key="Str.DataMissingRetry">Try again</sys:String>
  <sys:String x:Key="Str.DataMissingRetryBody">Looks for the folder again.</sys:String>
  <sys:String x:Key="Str.DataMissingDefault">Use the default folder</sys:String>
  <sys:String x:Key="Str.DataMissingDefaultBody">Starts from {0}, without your settings and game list. The other folder is left as it is.</sys:String>
</ResourceDictionary>
