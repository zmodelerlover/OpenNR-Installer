<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Spanish. The same keys as DataFolder.en.axaml, in its order. -->

  <sys:String x:Key="Str.DataFolderTitle">Carpeta de datos del instalador</sys:String>
  <sys:String x:Key="Str.DataFolderHint">Ajustes, lista de juegos, descargas y registros. Los juegos con NR instalado no la usan, así que moverla no les cambia nada.</sys:String>
  <sys:String x:Key="Str.DataFolderChange">Cambiar…</sys:String>
  <sys:String x:Key="Str.DataFolderDefault">Volver a la predeterminada</sys:String>
  <sys:String x:Key="Str.DataFolderPick">Elige dónde guarda el instalador sus datos</sys:String>
  <sys:String x:Key="Str.DataFolderNrLive">Cierra NRLive primero: se ejecuta desde la carpeta de datos.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveTitle">Mover la carpeta de datos</sys:String>
  <sys:String x:Key="Str.DataFolderMoveBody">A {0}. El instalador se reinicia al terminar.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAll">Mover todo</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAllBody">{0}, descargas incluidas. No hay que descargar nada otra vez.</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmpty">Empezar con la caché vacía</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmptyBody">Mueve los ajustes, la lista de juegos, los registros y tus runtimes ({0}). Las descargas se borran y vuelven cuando un juego las necesite.</sys:String>
  <sys:String x:Key="Str.DataFolderKeepBody">No se mueve nada.</sys:String>
  <sys:String x:Key="Str.DataFolderMoving">Moviendo… {0}%</sys:String>
  <sys:String x:Key="Str.DataFolderMoveFailed">El traslado no terminó ({0}). No cambió nada; los datos siguen en {1}.</sys:String>
  <sys:String x:Key="Str.DataFolderCancel">Cancelar</sys:String>
  <sys:String x:Key="Str.DataFolderMoveCancelled">Traslado cancelado. No cambió nada; los datos siguen en {0}.</sys:String>
  <sys:String x:Key="Str.DataFolderNested">Esa carpeta se solapa con la carpeta de datos del instalador. Elige otra.</sys:String>
  <sys:String x:Key="Str.DataFolderSystem">No puede estar dentro de Archivos de programa ni de Windows. Elige otra carpeta.</sys:String>
  <sys:String x:Key="Str.DataFolderGame">Esa carpeta está dentro de {0}, un juego de tu lista. Elige otra.</sys:String>
  <sys:String x:Key="Str.DataFolderNotEmpty">{0} ya tiene archivos. Elige una carpeta vacía.</sys:String>
  <sys:String x:Key="Str.DataFolderNotWritable">No se puede escribir en {0}. Elige otra carpeta.</sys:String>
  <sys:String x:Key="Str.DataFolderNoSpace">No hay espacio suficiente: el traslado necesita {0} y la unidad tiene {1} libres.</sys:String>
  <sys:String x:Key="Str.DataMissingTitle">No se encuentra la carpeta de datos</sys:String>
  <sys:String x:Key="Str.DataMissingBody">El instalador guarda sus datos en {0}, y esa carpeta no está. Si está en una unidad desconectada, conéctala y vuelve a intentarlo.</sys:String>
  <sys:String x:Key="Str.DataMissingRetry">Reintentar</sys:String>
  <sys:String x:Key="Str.DataMissingRetryBody">Busca la carpeta otra vez.</sys:String>
  <sys:String x:Key="Str.DataMissingDefault">Usar la carpeta predeterminada</sys:String>
  <sys:String x:Key="Str.DataMissingDefaultBody">Empieza en {0}, sin tus ajustes ni tu lista de juegos. La otra carpeta se queda como está.</sys:String>
  <sys:String x:Key="Str.SetupStepData">Dónde guardar los datos del instalador</sys:String>
  <sys:String x:Key="Str.SetupDataBody">La configuración, la lista de juegos, los registros y los archivos que descarga el instalador. Las descargas ocupan unos cuantos GB, así que elige una unidad con espacio para ellas.</sys:String>
  <sys:String x:Key="Str.SetupDataLater">Puedes cambiarlo más tarde en Configuración.</sys:String>
  <sys:String x:Key="Str.SetupDataPick">Elegir otra carpeta…</sys:String>
  <sys:String x:Key="Str.SetupDataIsDefault">La carpeta predeterminada</sys:String>
</ResourceDictionary>
