<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Italian. The same keys as DataFolder.en.axaml, in its order. -->

  <sys:String x:Key="Str.DataFolderTitle">Cartella dati dell’installer</sys:String>
  <sys:String x:Key="Str.DataFolderHint">Impostazioni, elenco dei giochi, download e log. I giochi con NR installato non la usano, quindi spostarla non cambia nulla per loro.</sys:String>
  <sys:String x:Key="Str.DataFolderChange">Cambia…</sys:String>
  <sys:String x:Key="Str.DataFolderDefault">Torna a quella predefinita</sys:String>
  <sys:String x:Key="Str.DataFolderPick">Scegli dove l’installer tiene i suoi dati</sys:String>
  <sys:String x:Key="Str.DataFolderNrLive">Chiudi prima NRLive: viene eseguito dalla cartella dati.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveTitle">Sposta la cartella dati</sys:String>
  <sys:String x:Key="Str.DataFolderMoveBody">In {0}. L’installer si riavvia alla fine.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAll">Sposta tutto</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAllBody">{0}, download compresi. Non serve riscaricare nulla.</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmpty">Riparti con la cache vuota</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmptyBody">Sposta impostazioni, elenco dei giochi, log e i tuoi runtime ({0}). I download vengono eliminati e tornano quando un gioco ne ha bisogno.</sys:String>
  <sys:String x:Key="Str.DataFolderKeepBody">Non si sposta nulla.</sys:String>
  <sys:String x:Key="Str.DataFolderMoving">Spostamento… {0}%</sys:String>
  <sys:String x:Key="Str.DataFolderMoveFailed">Lo spostamento non è terminato ({0}). Non è cambiato nulla; i dati sono ancora in {1}.</sys:String>
  <sys:String x:Key="Str.DataFolderNested">Quella cartella si sovrappone alla cartella dati dell’installer. Scegline un’altra.</sys:String>
  <sys:String x:Key="Str.DataFolderSystem">Non dentro Programmi o Windows. Scegli un’altra cartella.</sys:String>
  <sys:String x:Key="Str.DataFolderGame">Quella cartella è dentro {0}, un gioco del tuo elenco. Scegline un’altra.</sys:String>
  <sys:String x:Key="Str.DataFolderNotEmpty">{0} contiene già dei file. Scegli una cartella vuota.</sys:String>
  <sys:String x:Key="Str.DataFolderNotWritable">Impossibile scrivere in {0}. Scegli un’altra cartella.</sys:String>
  <sys:String x:Key="Str.DataFolderNoSpace">Spazio insufficiente: lo spostamento richiede {0} e l’unità ha {1} liberi.</sys:String>
  <sys:String x:Key="Str.DataMissingTitle">Cartella dati non trovata</sys:String>
  <sys:String x:Key="Str.DataMissingBody">L’installer tiene i suoi dati in {0}, e quella cartella non c’è. Se è su un’unità scollegata, collegala e riprova.</sys:String>
  <sys:String x:Key="Str.DataMissingRetry">Riprova</sys:String>
  <sys:String x:Key="Str.DataMissingRetryBody">Cerca di nuovo la cartella.</sys:String>
  <sys:String x:Key="Str.DataMissingDefault">Usa la cartella predefinita</sys:String>
  <sys:String x:Key="Str.DataMissingDefaultBody">Riparte da {0}, senza le tue impostazioni né l’elenco dei giochi. L’altra cartella resta com’è.</sys:String>
</ResourceDictionary>
