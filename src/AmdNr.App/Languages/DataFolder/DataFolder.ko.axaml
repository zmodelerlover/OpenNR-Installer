<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Korean. The same keys as DataFolder.en.axaml, in its order. -->

  <sys:String x:Key="Str.DataFolderTitle">설치 프로그램 데이터 폴더</sys:String>
  <sys:String x:Key="Str.DataFolderHint">설정, 게임 목록, 다운로드, 로그. NR이 설치된 게임은 이 폴더를 쓰지 않으므로 옮겨도 게임에는 아무 변화가 없습니다.</sys:String>
  <sys:String x:Key="Str.DataFolderChange">변경…</sys:String>
  <sys:String x:Key="Str.DataFolderDefault">기본값으로 되돌리기</sys:String>
  <sys:String x:Key="Str.DataFolderPick">설치 프로그램이 데이터를 보관할 위치 선택</sys:String>
  <sys:String x:Key="Str.DataFolderNrLive">먼저 NRLive를 닫으세요. 데이터 폴더에서 실행 중입니다.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveTitle">데이터 폴더 옮기기</sys:String>
  <sys:String x:Key="Str.DataFolderMoveBody">{0}(으)로. 완료되면 설치 프로그램이 다시 시작됩니다.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAll">전부 옮기기</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAllBody">{0}, 다운로드 포함. 다시 받을 필요가 없습니다.</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmpty">빈 캐시로 시작</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmptyBody">설정, 게임 목록, 로그, 런타임({0})을 옮깁니다. 다운로드는 삭제되고 게임에 필요할 때 다시 받습니다.</sys:String>
  <sys:String x:Key="Str.DataFolderKeepBody">아무것도 옮기지 않습니다.</sys:String>
  <sys:String x:Key="Str.DataFolderMoving">옮기는 중… {0}%</sys:String>
  <sys:String x:Key="Str.DataFolderMoveFailed">옮기기를 마치지 못했습니다({0}). 바뀐 것은 없으며 데이터는 그대로 {1}에 있습니다.</sys:String>
  <sys:String x:Key="Str.DataFolderCancel">취소</sys:String>
  <sys:String x:Key="Str.DataFolderMoveCancelled">이동을 취소했습니다. 아무것도 바뀌지 않았으며 데이터는 계속 {0}에 있습니다.</sys:String>
  <sys:String x:Key="Str.DataFolderNested">이 폴더는 설치 프로그램의 데이터 폴더와 겹칩니다. 다른 폴더를 고르세요.</sys:String>
  <sys:String x:Key="Str.DataFolderSystem">Program Files나 Windows 안은 안 됩니다. 다른 폴더를 고르세요.</sys:String>
  <sys:String x:Key="Str.DataFolderGame">이 폴더는 목록에 있는 게임 {0} 안에 있습니다. 다른 폴더를 고르세요.</sys:String>
  <sys:String x:Key="Str.DataFolderNotEmpty">{0}에 이미 파일이 있습니다. 빈 폴더를 고르세요.</sys:String>
  <sys:String x:Key="Str.DataFolderNotWritable">{0}에 쓸 수 없습니다. 다른 폴더를 고르세요.</sys:String>
  <sys:String x:Key="Str.DataFolderNoSpace">공간이 부족합니다. 옮기려면 {0}이(가) 필요한데 드라이브 여유 공간은 {1}입니다.</sys:String>
  <sys:String x:Key="Str.DataMissingTitle">데이터 폴더를 찾을 수 없음</sys:String>
  <sys:String x:Key="Str.DataMissingBody">설치 프로그램은 데이터를 {0}에 보관하는데 그 폴더가 없습니다. 분리된 드라이브에 있다면 연결한 뒤 다시 시도하세요.</sys:String>
  <sys:String x:Key="Str.DataMissingRetry">다시 시도</sys:String>
  <sys:String x:Key="Str.DataMissingRetryBody">폴더를 다시 찾습니다.</sys:String>
  <sys:String x:Key="Str.DataMissingDefault">기본 폴더 사용</sys:String>
  <sys:String x:Key="Str.DataMissingDefaultBody">설정과 게임 목록 없이 {0}에서 처음부터 시작합니다. 다른 폴더는 그대로 둡니다.</sys:String>
  <sys:String x:Key="Str.SetupStepData">설치 프로그램 데이터를 보관할 위치</sys:String>
  <sys:String x:Key="Str.SetupDataBody">설정, 게임 목록, 로그, 설치 프로그램이 다운로드하는 파일입니다. 다운로드에 몇 GB가 필요하니 공간이 넉넉한 드라이브를 고르세요.</sys:String>
  <sys:String x:Key="Str.SetupDataLater">나중에 설정에서 바꿀 수 있습니다.</sys:String>
  <sys:String x:Key="Str.SetupDataPick">다른 폴더 선택…</sys:String>
  <sys:String x:Key="Str.SetupDataIsDefault">기본 폴더</sys:String>
</ResourceDictionary>
