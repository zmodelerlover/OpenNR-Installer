<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Romanian. The same keys as DataFolder.en.axaml, in its order. -->

  <sys:String x:Key="Str.DataFolderTitle">Folderul de date al instalatorului</sys:String>
  <sys:String x:Key="Str.DataFolderHint">Setări, lista de jocuri, descărcări și jurnale. Jocurile cu NR instalat nu îl folosesc, așa că mutarea lui nu schimbă nimic la ele.</sys:String>
  <sys:String x:Key="Str.DataFolderChange">Schimbă…</sys:String>
  <sys:String x:Key="Str.DataFolderDefault">Înapoi la implicit</sys:String>
  <sys:String x:Key="Str.DataFolderPick">Alege unde își păstrează instalatorul datele</sys:String>
  <sys:String x:Key="Str.DataFolderNrLive">Închide mai întâi NRLive: rulează din folderul de date.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveTitle">Mută folderul de date</sys:String>
  <sys:String x:Key="Str.DataFolderMoveBody">În {0}. Instalatorul repornește la final.</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAll">Mută tot</sys:String>
  <sys:String x:Key="Str.DataFolderMoveAllBody">{0}, cu tot cu descărcări. Nu trebuie descărcat nimic din nou.</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmpty">Pornește cu memoria cache goală</sys:String>
  <sys:String x:Key="Str.DataFolderStartEmptyBody">Mută setările, lista de jocuri, jurnalele și runtime-urile tale ({0}). Descărcările se șterg și revin când un joc are nevoie de ele.</sys:String>
  <sys:String x:Key="Str.DataFolderKeepBody">Nu se mută nimic.</sys:String>
  <sys:String x:Key="Str.DataFolderMoving">Se mută… {0}%</sys:String>
  <sys:String x:Key="Str.DataFolderMoveFailed">Mutarea nu s-a terminat ({0}). Nu s-a schimbat nimic; datele sunt tot în {1}.</sys:String>
  <sys:String x:Key="Str.DataFolderCancel">Anulează</sys:String>
  <sys:String x:Key="Str.DataFolderMoveCancelled">Mutarea a fost anulată. Nu s-a schimbat nimic; datele sunt tot în {0}.</sys:String>
  <sys:String x:Key="Str.DataFolderNested">Folderul acesta se suprapune cu folderul de date al instalatorului. Alege altul.</sys:String>
  <sys:String x:Key="Str.DataFolderSystem">Nu în Program Files sau Windows. Alege alt folder.</sys:String>
  <sys:String x:Key="Str.DataFolderGame">Folderul acesta e în {0}, un joc din lista ta. Alege altul.</sys:String>
  <sys:String x:Key="Str.DataFolderNotEmpty">{0} are deja fișiere. Alege un folder gol.</sys:String>
  <sys:String x:Key="Str.DataFolderNotWritable">Nu se poate scrie în {0}. Alege alt folder.</sys:String>
  <sys:String x:Key="Str.DataFolderNoSpace">Nu e destul spațiu: mutarea are nevoie de {0}, iar unitatea are {1} liberi.</sys:String>
  <sys:String x:Key="Str.DataMissingTitle">Folderul de date nu a fost găsit</sys:String>
  <sys:String x:Key="Str.DataMissingBody">Instalatorul își păstrează datele în {0}, iar folderul acesta nu există. Dacă e pe o unitate deconectată, conecteaz-o și încearcă din nou.</sys:String>
  <sys:String x:Key="Str.DataMissingRetry">Încearcă din nou</sys:String>
  <sys:String x:Key="Str.DataMissingRetryBody">Caută din nou folderul.</sys:String>
  <sys:String x:Key="Str.DataMissingDefault">Folosește folderul implicit</sys:String>
  <sys:String x:Key="Str.DataMissingDefaultBody">Pornește de la zero în {0}, fără setările și lista ta de jocuri. Celălalt folder rămâne neatins.</sys:String>
</ResourceDictionary>
