<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Croatian. The same keys as HexNeural.en.axaml, in its order. -->

  <sys:String x:Key="Str.HexNeuralNote">HexNeural: isključen dok ga ne označiš. Eksperimentalan, od Emiona (GPL; izvorni kod na njegovom GitHubu), samo za grafičke kartice RX 6000. Označen postaje NR runtime igre (NrBackend=rdna2), radi prije skaliranja i gradi mrežu iz nvngx_dlssnr.dll same igre; igra bez te datoteke ne dobiva NR od njega. Postavke su pod RDNA2 network u kartici Neural OptiScalera. Kad se odznači, uklanja se.</sys:String>
</ResourceDictionary>
