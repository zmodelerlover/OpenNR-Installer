  <sys:String x:Key="Str.NrLiveSet.FPS.background">الخلفية</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">إطار النص</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">حجم النص</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">عتامة الخلفية</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">تقنية رفع الدقة</sys:String>
