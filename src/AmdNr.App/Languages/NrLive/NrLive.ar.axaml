  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">قناع الشخصيات</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">البشرة منفصلة عن البنية</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">اللون من NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">قوة السجل</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">السجل الزمني</sys:String>
