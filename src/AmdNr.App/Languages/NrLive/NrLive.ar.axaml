  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">الجديد، أسرع</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">النمط</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">محايد</sys:String>
