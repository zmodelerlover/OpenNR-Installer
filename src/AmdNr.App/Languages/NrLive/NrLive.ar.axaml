  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">قوة السجل</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">اكتشاف البشرة تلقائيًا</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">المثبِّت</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">عدّاد الإطارات</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">موضع العدّاد</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">أعلى اليسار</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">أعلى اليمين</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">أسفل اليسار</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">أسفل اليمين</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">الإطارات في الثانية</sys:String>
