<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Arabic. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">يعرض اللعبة في نافذة خاصة بها، مُكبَّرة بتقنية FSR، مع توليد الإطارات وNR فوقها، دون تغيير أي ملف من ملفات اللعبة. للألعاب التي تحميها أنظمة مكافحة الغش، حيث لا يجوز حقن أي شيء.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} غير موجود على هذا الحاسوب بعد</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">نحو {0}، يُنزَّل مرة واحدة إلى مجلد هذا التطبيق ويُتحقَّق منه مثل كل الملفات الأخرى. لا يُثبَّت شيء في أي لعبة.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">تنزيل NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} جاهز</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">التحديث إلى {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">صدر NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">لم يُنشر NRLive لـ OpenNR بعد</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">سيصل مع تحديث للملفات، دون الحاجة إلى إعادة تثبيت أي شيء هنا. وحتى ذلك الحين، يمكن تشغيله من إصداره الخاص.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">إصداراته</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">تعذّر تنزيل NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">جلسة التكبير</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">ما الذي يُلتقط</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">النافذة الأمامية عند انتهاء العدّ التنازلي</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">نافذة مفتوحة الآن</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">لعبة من المكتبة</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">لا شيء للاختيار</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">إعادة قراءة النوافذ المفتوحة</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">العدّ التنازلي (ث)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">تكبير</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">جارٍ البدء · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">إيقاف</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">جاهز متى شئت</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">انتقل إلى اللعبة</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">جارٍ التكبير</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">اضغط «تكبير»، ثم انتقل إلى اللعبة قبل انتهاء العدّ التنازلي.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">يأخذ NRLive نافذة اللعبة عند انتهاء العدّ التنازلي: انتقل إليها الآن.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">لإنهائه اضغط «إيقاف»، أو {0} من داخل اللعبة.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">توقّف.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">أُغلق NRLive. السبب في NRLive.log داخل مجلده.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">لم يبدأ NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">يعمل NRLive كمسؤول، خارج نطاق هذا التطبيق: اضغط {0} لإيقافه.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">التشغيل كمسؤول</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">اللعبة التي تعمل كمسؤول، كمعظم الألعاب ذات أنظمة مكافحة الغش، لا تستقبل الإدخال عبر NRLive إلا إذا كان NRLive يعمل كمسؤول أيضًا. يسأل Windows في كل مرة.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">يجب أن تختلف مفاتيح الاختصار للتكبير والإيقاف والواجهة المتراكبة عن بعضها.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">أحد مفاتيح الاختصار لا يستطيع NRLive قراءته. يقبل مفاتيح تعديل ومفتاحًا واحدًا، مثل ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">يجب أن تكون مفاتيح التمرير مفاتيح يستطيع NRLive قراءتها، تفصل بينها فواصل، مثل home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">اختر أولًا ما الذي يُلتقط.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">رفض Windows حجز {0}: يستخدمه تطبيق آخر. اختر تركيبة أخرى.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">يُحفظ في ملف scaleconfig.ini الخاص بـ NRLive، الذي تعدّله واجهته المتراكبة أيضًا. يسري التغيير من المرة التالية التي يُضغط فيها «تكبير».</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">رفع الدقة والإطارات</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">العرض العصبي</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">الواجهة المتراكبة</sys:String>
  <sys:String x:Key="Str.NrLiveMore">مزيد من الإعدادات</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">يحتاج NR إلى نموذج NVIDIA في dlssnr-amd، وقد جاء NRLive هذا من دونه. يشرح ملف DLSSNR-AMD-SETUP.txt في مجلده كيفية استخراجه من ملف DLL الخاص بك.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">واجهة NRLive المتراكبة (الشريط والعدّاد)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">الالتقاط</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">مصدر الالتقاط</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (الافتراضي)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI، مقصوصًا على حدود النافذة</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">متجهات الحركة</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (الافتراضي)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">التدفق البصري من AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">مفاتيح الاختصار</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">انقر على خانة واضغط التركيبة. يعمل «تكبير وإيقاف» في أي مكان، بما في ذلك داخل اللعبة، ما دام هذا التطبيق مفتوحًا.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">تكبير وإيقاف</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">إيقاف إجباري</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">الواجهة المتراكبة</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">مفاتيح التمرير</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">مفاتيح تُمرَّر إلى OptiScaler أو ReShade في اللعبة بدلًا من NRLive، تفصل بينها فواصل.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive من إعداد Caliel، وهو برنامج حر بترخيص GPL-3.0. شيفرته المصدرية:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — من إعداد Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">يعرض اللعبة مُكبَّرة في نافذة خاصة بها، للألعاب ذات أنظمة مكافحة الغش. برنامج حر بترخيص GPL-3.0، وشيفرته المصدرية على GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">عُثر على {0} في هذه اللعبة</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">قد يحظر نظام مكافحة الغش الحساب بسبب ملف DLL يوضع في اللعبة، وكلتا طريقتي التثبيت هنا تضعان ملفًا من هذا النوع. أما NRLive فيكبّر نافذة اللعبة من الخارج، مع FSR وتوليد الإطارات وNR، ولا يغيّر شيئًا في مجلدها.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">استخدام NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">تجاهُل لهذه اللعبة</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">الحدّة</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">توليد الإطارات</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">حدّ الإطارات</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">الحدّ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">توقيت المحدِّد</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">سلس</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">زمن استجابة منخفض</sys:String>
