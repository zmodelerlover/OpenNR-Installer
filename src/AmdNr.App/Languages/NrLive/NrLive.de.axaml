<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- German. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Zeigt ein Spiel in einem eigenen Fenster, mit FSR skaliert und mit Frame Generation und NR obendrauf, ohne eine Datei des Spiels zu ändern. Für Spiele mit Anti-Cheat, in die nichts injiziert werden darf.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} ist noch nicht auf diesem PC</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Etwa {0}, einmal in den Ordner dieser App heruntergeladen und wie jede andere Datei geprüft. In keinem Spiel wird etwas installiert.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">NRLive herunterladen</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} ist bereit</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Auf {0} aktualisieren</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} ist erschienen.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive ist für OpenNR noch nicht veröffentlicht</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Es kommt mit einem Datei-Update, ohne dass hier etwas neu installiert werden muss. Bis dahin läuft es aus seinem eigenen Release.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Seine Releases</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">NRLive konnte nicht heruntergeladen werden: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Skalierungssitzung</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Was erfasst wird</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Das Fenster im Vordergrund, wenn der Countdown endet</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Ein gerade offenes Fenster</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Ein Spiel aus der Bibliothek</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nichts zur Auswahl</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Offene Fenster neu einlesen</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Countdown (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Skalieren</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Startet · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Stoppen</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Bereit, wenn du es bist</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Wechsle ins Spiel</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Skaliert</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Drücke Skalieren und wechsle ins Spiel, bevor der Countdown endet.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive übernimmt das Spielfenster, wenn der Countdown endet: Wechsle jetzt dorthin.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Stoppen oder {0} im Spiel beendet es.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Gestoppt.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive wurde beendet. Warum, steht in NRLive.log in seinem Ordner.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive ist nicht gestartet: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive läuft als Administrator, außer Reichweite dieser App: Drücke {0}, um es zu stoppen.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Als Administrator ausführen</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Ein Spiel, das als Administrator läuft, wie die meisten mit Anti-Cheat, nimmt Eingaben über NRLive nur an, wenn NRLive ebenfalls als Administrator läuft. Windows fragt jedes Mal nach.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Die Tastenkürzel für Skalieren, Stoppen und Overlay müssen sich alle unterscheiden.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Ein Tastenkürzel kann NRLive nicht lesen. Es nimmt Modifikatoren und eine Taste, etwa ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Die durchgereichten Tasten müssen Tasten sein, die NRLive lesen kann, durch Kommas getrennt, etwa home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Wähle zuerst, was erfasst werden soll.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows hat {0} nicht angenommen: Eine andere App belegt es. Wähle eine andere Kombination.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Gespeichert in der scaleconfig.ini von NRLive, die auch sein Overlay bearbeitet. Eine Änderung gilt ab dem nächsten Druck auf Skalieren.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Upscaling und Frames</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Neuronales Rendering</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Weitere Einstellungen</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR braucht das Modell von NVIDIA in dlssnr-amd, und dieses NRLive kam ohne. DLSSNR-AMD-SETUP.txt in seinem Ordner erklärt, wie du es aus deiner eigenen DLL extrahierst.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Overlay von NRLive (Leiste und Zähler)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Erfassung</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Erfassungsquelle</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (Standard)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, auf das Fenster zugeschnitten</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Bewegungsvektoren</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (Standard)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD Optical Flow</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Tastenkürzel</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Klicke in ein Feld und drücke die Kombination. Skalieren und Stoppen funktioniert überall, auch im Spiel, solange diese App offen ist.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Skalieren und Stoppen</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Stopp erzwingen</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Durchgereichte Tasten</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Tasten, die im Spiel an OptiScaler oder ReShade gehen statt an NRLive, durch Kommas getrennt.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive stammt von Caliel und ist freie Software unter der GPL-3.0. Der Quellcode:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive, von Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Zeigt ein Spiel skaliert in einem eigenen Fenster, für Spiele mit Anti-Cheat. Freie Software unter der GPL-3.0; der Quellcode liegt auf GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">{0} in diesem Spiel gefunden</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Ein Anti-Cheat kann das Konto für eine DLL im Spiel sperren, und beide Installationswege hier legen eine ab. NRLive skaliert das Spielfenster von außen, mit FSR, Frame Generation und NR, und ändert nichts in seinem Ordner.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">NRLive verwenden</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Für dieses Spiel ignorieren</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.2">Keiner</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Schärfe</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Frame Generation</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Frame-Limit</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Begrenzen auf</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Taktung des Limiters</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Gleichmäßig</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Niedrige Latenz</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">NR-Runtime</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Die von NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Modell</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Original</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Neu, schneller</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Stil</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutral</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Natürlich</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Filmisch</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Auflösung, in der NR läuft</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensität</sys:String>
  <sys:String x:Key="Str.NrLiveSet.RenoDX.enabled">RenoDX-Look</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Durchgänge</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Struktur</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Farbe aus NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Lokaler Ton</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Maximales Verhältnis</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Hautstruktur</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Stärke des Verlaufs</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Haut selbst erkennen</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilisierung</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Frame-Zähler</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Position des Zählers</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Oben links</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Oben rechts</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Unten links</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Unten rechts</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu">GPU-Auslastung und -Temperatur</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Bilder pro Sekunde</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Frametime</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Frametime-Graph</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Auflösung</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Hintergrund</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Textkontur</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Textgröße</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Deckkraft des Hintergrunds</sys:String>

</ResourceDictionary>
