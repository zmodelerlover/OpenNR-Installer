  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Top left</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Top right</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Bottom left</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Bottom right</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Frames per second</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Frame time</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Frame time graph</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Resolution</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Background</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Text outline</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Text size</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Background opacity</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">None (native scaling)</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">NR needs NVIDIA's model in the opennr folder, and it is not there. Download NRLive again from this page to put it back.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Original model (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Style</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Standard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Natural</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">Cinematic</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">Intensity</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">Passes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">Local tone</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Local structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Skin structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Character mask</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Skin kept apart from structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Colour from NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">History strength</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Temporal history</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Style grade</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">ACO shader compiler (from the next start)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">HUD preset</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Custom</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Minimal</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Compact</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Standard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Full</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Top centre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Bottom centre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1% and 0.1% lows</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU load</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU temperature</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU load</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR, NR and FG state</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">GPU time of each pass</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">HUD size</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">How the game&apos;s frames and motion are read</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">Shown on screen (click to switch)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">HUD preview</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">One frame made between every two the game draws</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">Settings for</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">Global</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (global settings)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">Use global settings</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">Deletes the settings of {0} and goes back to the global ones.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">A library game gets settings of its own the first time you change one while it is shown here. When the countdown ends on a window, its game's settings are used if it has them. What to capture, the countdown, the scale hotkey and running as administrator stay the same for every game.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">Settings: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">Settings: {0}. Its upscaler, capture and keys apply when it is picked as the target.</sys:String>
  <!-- The look and encoding keys, grouped as in OptiScaler's menu -->
  <sys:String x:Key="Str.NrLiveGroup.composition">Composition</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.composition.Hint">How the model's answer is put back into the frame.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look">Adjust NR's look</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look.Hint">Edits the model's change before it is composed: how much it brightens, darkens and colours.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding">Encoding</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding.Hint">What the captured frame is taken to be. From the format keeps NRLive's usual SDR path; choosing SDR, Linear or PQ moves it to the HDR codec, and the settings marked here start to act.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess">Preprocess</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess.Hint">Changes the picture the network is shown (exposure, curve, contrast, saturation) and takes it back out of its answer, so it changes how the network edits the frame.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4">int4 mixed network (Original model)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4.Off">Made from the 310.8 model only, so it does not run on the new Small model. Your choice is kept for when you go back to the Original model.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiNoiseEveryFrame">Vary noise without motion vectors</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferStrength">Brightness change kept</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoChromaClamp">Largest colour change</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferMode">Transfer mode</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferMode.0">Bounded ratio</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferMode.1">Consistent</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore">SDR black restore</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore.0">Auto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore.1">Every block</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore.2">Smooth</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoCodecMode">Codec (HDR)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoCodecMode.0">Classic</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoCodecMode.1">Anchored</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoCodecMode.2">Auto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoCodecMode.3">Display</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookMode">Adjust NR's look</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookStrength">Edit strength</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookBrighten">Brightening</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookDarken">Darkening</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookColour">Colour</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookHue">Hue shift</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookShadows">Shadows</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookMidtones">Midtones</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookHighlights">Highlights</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookMaxBrighten">Most brightening (0: no limit)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookMaxDarken">Most darkening (0: no limit)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookMaxColour">Largest colour change (0: no limit)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookTone">Large-scale tone</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookDetail">Fine detail</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookDetailRadius">Detail radius</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookHalo">Halo suppression</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLookHaloBrightSide">Halo next to dark objects</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSourceEncoding">Source encoding</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSourceEncoding.0">From the format</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSourceEncoding.1">SDR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSourceEncoding.2">Linear</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSourceEncoding.3">PQ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLinearUnitNits">Linear unit</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoProxyAnchor">Proxy anchor</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPaperWhiteScale">Paper white scale</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoDiffuseWhiteNits">Diffuse white</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPQCalibration">PQ calibration</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoFeedMode">Feed</sys:String>
