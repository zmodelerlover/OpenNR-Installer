<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Spanish. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Ejecuta un juego en una ventana propia, escalado con FSR, con generación de fotogramas y NR encima, sin cambiar ningún archivo del juego. Para juegos con anticheat, donde no se puede inyectar nada.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} aún no está en este PC</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Unos {0}, se descarga una vez en la carpeta de esta app y se verifica como cualquier otro archivo. No se instala nada en ningún juego.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Descargar NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} está listo</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Actualizar a {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">Ya salió NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive aún no está publicado para OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Llegará con una actualización de archivos, sin reinstalar nada aquí. Mientras tanto, se puede usar desde su propia versión.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Sus versiones</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">No se pudo descargar NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Sesión de escalado</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Qué capturar</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">La ventana en primer plano al terminar la cuenta atrás</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Una ventana abierta ahora</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Un juego de la biblioteca</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nada que elegir</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Volver a leer las ventanas abiertas</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Cuenta atrás (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Escalar</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Iniciando · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Detener</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Listo cuando quieras</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Cambia al juego</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Escalando</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Pulsa Escalar y cambia al juego antes de que termine la cuenta atrás.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive toma la ventana del juego cuando termina la cuenta atrás: cambia a ella ahora.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Detener, o {0} desde dentro del juego, lo termina.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Detenido.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive se cerró. El motivo está en NRLive.log, en su carpeta.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive no se inició: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive se ejecuta como administrador, fuera del alcance de esta app: pulsa {0} para detenerlo.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Ejecutar como administrador</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Un juego que se ejecuta como administrador, como la mayoría de los que tienen anticheat, solo recibe la entrada a través de NRLive si NRLive también se ejecuta como administrador. Windows lo pregunta cada vez.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Los atajos de escalar, detener y overlay tienen que ser distintos.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Hay un atajo que NRLive no puede leer. Admite modificadores y una tecla, como ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Las teclas de paso tienen que ser teclas que NRLive pueda leer, separadas por comas, como home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Primero elige qué capturar.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows no aceptó {0}: otra app ya lo usa. Elige otra combinación.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Se guarda en el scaleconfig.ini de NRLive, que su overlay también edita. Los cambios cuentan a partir de la próxima vez que se pulse Escalar.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Escalado y fotogramas</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Renderizado neuronal</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Más ajustes</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR necesita el modelo de NVIDIA en dlssnr-amd, y este NRLive vino sin él. DLSSNR-AMD-SETUP.txt, en su carpeta, explica cómo extraerlo de tu propia DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Overlay de NRLive (barra y contador)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Captura</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Origen de la captura</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (predeterminado)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, recortado a la ventana</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Vectores de movimiento</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (predeterminado)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Flujo óptico de AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Atajos</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Haz clic en una casilla y pulsa la combinación. Escalar y detener funciona en cualquier sitio, también en el juego, mientras esta app esté abierta.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Escalar y detener</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Forzar detención</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Teclas de paso</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Teclas que llegan a OptiScaler o ReShade en el juego en lugar de a NRLive, separadas por comas.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive lo hace Caliel y es software libre bajo la GPL-3.0. Su código fuente:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive, de Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Ejecuta un juego escalado en una ventana propia, para juegos con anticheat. Software libre bajo la GPL-3.0; su código está en GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">Se encontró {0} en este juego</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Un anticheat puede banear la cuenta por una DLL puesta en el juego, y las dos formas de instalar de aquí ponen una. NRLive escala la ventana del juego desde fuera, con FSR, generación de fotogramas y NR, y no cambia nada en su carpeta.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Usar NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Ignorar en este juego</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Nitidez</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Generación de fotogramas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Límite de fotogramas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Limitar a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Ritmo del limitador</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Suave</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Baja latencia</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Runtime de NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Automático</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">Puente 0.0.6 de NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Modelo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Original</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Nuevo, más rápido</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Estilo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutro</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Natural</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Cinematográfico</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Resolución a la que funciona NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensidad</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Pasadas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Estructura</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Color de NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Tono local</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Proporción máxima</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Estructura de la piel</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Fuerza del historial</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Detectar la piel solo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Estabilizador</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Contador de fotogramas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Posición del contador</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Arriba a la izquierda</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Arriba a la derecha</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Abajo a la izquierda</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Abajo a la derecha</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Fotogramas por segundo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Tiempo de fotograma</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Gráfico de tiempo de fotograma</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Resolución</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Fondo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Contorno del texto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Tamaño del texto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Opacidad del fondo</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Escalador</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">Ninguno (escalado nativo)</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">NR necesita el modelo de NVIDIA en la carpeta opennr, y no está ahí. Vuelve a descargar NRLive desde esta página para recuperarlo.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Modelo original (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Estilo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Estándar</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Natural</sys:String>
