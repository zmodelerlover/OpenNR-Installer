  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">Intensidad</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">Pasadas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">Tono local</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Estructura local</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Estructura de la piel</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Máscara de personajes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Piel separada de la estructura</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Color de NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Fuerza del historial</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Historial temporal</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Gradación del estilo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">Compilador de shaders ACO (desde el próximo inicio)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">Preajuste del HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Personalizado</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Mínimo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Compacto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Estándar</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Completo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Arriba en el centro</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Abajo en el centro</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">Mínimos del 1% y 0,1%</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">Uso de la GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">Temperatura de la GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">Uso de la CPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">Estado de FSR, NR y FG</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Tiempo de GPU de cada pasada</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">Tamaño del HUD</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Cómo se leen los fotogramas y el movimiento del juego</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">En pantalla (haz clic para alternar)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">Vista previa del HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Un fotograma creado entre cada dos que dibuja el juego</sys:String>

