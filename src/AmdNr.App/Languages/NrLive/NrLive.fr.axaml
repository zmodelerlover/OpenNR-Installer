  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Force de l'historique</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Historique temporel</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Étalonnage du style</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">Compilateur de shaders ACO (au prochain démarrage)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">Préréglage du HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Personnalisé</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Minimal</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Compact</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Standard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Complet</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">En haut au centre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">En bas au centre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">Minimums 1 % et 0,1 %</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">Charge du GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">Température du GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">Charge du CPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">État de FSR, NR et FG</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Temps GPU de chaque passe</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">Taille du HUD</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Comment les images et le mouvement du jeu sont lus</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">À l&apos;écran (cliquez pour basculer)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">Aperçu du HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Une image créée entre chaque paire que le jeu dessine</sys:String>

</ResourceDictionary>
