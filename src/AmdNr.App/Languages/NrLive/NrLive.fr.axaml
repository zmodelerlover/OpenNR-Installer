<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- French. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Affiche un jeu dans sa propre fenêtre, mis à l'échelle avec FSR, avec génération d'images et NR par-dessus, sans modifier aucun fichier du jeu. Pour les jeux avec anti-triche, où rien ne doit être injecté.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} n'est pas encore sur ce PC</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Environ {0}, téléchargé une seule fois dans le dossier de cette application et vérifié comme tous les autres fichiers. Rien n'est installé dans un jeu.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Télécharger NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} est prêt</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Mettre à jour vers {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} est sorti.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive n'est pas encore publié pour OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Il arrivera avec une mise à jour des fichiers, sans rien réinstaller ici. D'ici là, il fonctionne depuis sa propre version.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Ses versions</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Impossible de télécharger NRLive : {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Session de mise à l'échelle</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Que capturer</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">La fenêtre au premier plan à la fin du compte à rebours</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Une fenêtre ouverte maintenant</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Un jeu de la bibliothèque</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Rien à choisir</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Relire les fenêtres ouvertes</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Compte à rebours (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Mettre à l'échelle</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Démarrage · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Arrêter</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Prêt quand vous l'êtes</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Passez au jeu</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Mise à l'échelle en cours</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Cliquez sur Mettre à l'échelle, puis passez au jeu avant la fin du compte à rebours.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive prend la fenêtre du jeu à la fin du compte à rebours : passez-y maintenant.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Arrêter, ou {0} depuis le jeu, y met fin.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Arrêté.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive s'est fermé. La raison est dans NRLive.log, dans son dossier.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive n'a pas démarré : {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive tourne en administrateur, hors de portée de cette application : appuyez sur {0} pour l'arrêter.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Exécuter en tant qu'administrateur</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Un jeu lancé en administrateur, comme la plupart de ceux qui ont un anti-triche, ne reçoit les commandes via NRLive que si NRLive tourne lui aussi en administrateur. Windows le demande à chaque fois.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Les raccourcis de mise à l'échelle, d'arrêt et d'overlay doivent tous être différents.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Un raccourci n'est pas lisible par NRLive. Il accepte des modificateurs et une touche, par exemple ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Les touches transmises doivent être des touches que NRLive sait lire, séparées par des virgules, par exemple home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Choisissez d'abord quoi capturer.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows a refusé {0} : une autre application l'utilise. Choisissez une autre combinaison.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Enregistré dans le scaleconfig.ini de NRLive, que son overlay modifie aussi. Un changement s'applique à la prochaine pression sur Mettre à l'échelle.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Upscaling et images</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Rendu neuronal</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Plus de réglages</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR a besoin du modèle de NVIDIA dans dlssnr-amd, et ce NRLive est arrivé sans. DLSSNR-AMD-SETUP.txt, dans son dossier, explique comment l'extraire de votre propre DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Overlay de NRLive (barre et compteur)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Capture</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Source de capture</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (par défaut)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, recadré sur la fenêtre</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Vecteurs de mouvement</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (par défaut)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Flux optique AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Raccourcis</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Cliquez dans une case et appuyez sur la combinaison. Mettre à l'échelle et arrêter fonctionne partout, y compris en jeu, tant que cette application est ouverte.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Mettre à l'échelle et arrêter</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Forcer l'arrêt</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Touches transmises</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Touches envoyées à OptiScaler ou à ReShade dans le jeu plutôt qu'à NRLive, séparées par des virgules.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive est créé par Caliel et c'est un logiciel libre sous GPL-3.0. Son code source :</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive, par Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Affiche un jeu mis à l'échelle dans sa propre fenêtre, pour les jeux avec anti-triche. Logiciel libre sous GPL-3.0 ; son code est sur GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">{0} détecté dans ce jeu</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Un anti-triche peut bannir le compte pour une DLL placée dans le jeu, et les deux méthodes d'installation proposées ici en placent une. NRLive met à l'échelle la fenêtre du jeu depuis l'extérieur, avec FSR, génération d'images et NR, et ne change rien dans son dossier.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Utiliser NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Ignorer pour ce jeu</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Netteté</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Génération d'images</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Limite d'images</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Limiter à</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Cadence du limiteur</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Fluide</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Faible latence</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Runtime NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Automatique</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">Pont 0.0.6 de NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Modèle</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Original</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Nouveau, plus rapide</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Style</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Naturel</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Cinématique</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Résolution de travail de NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensité</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Passes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Couleur issue de NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Tonalité locale</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Ratio maximal</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Structure de la peau</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Force de l'historique</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Détecter la peau automatiquement</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilisateur</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Compteur d'images</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Position du compteur</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">En haut à gauche</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">En haut à droite</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">En bas à gauche</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">En bas à droite</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Images par seconde</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Temps d'image</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Graphique du temps d'image</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Résolution</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Fond</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Contour du texte</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Taille du texte</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Opacité du fond</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">Aucun (mise à l'échelle native)</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">NR a besoin du modèle de NVIDIA dans le dossier opennr, et il n'y est pas. Téléchargez à nouveau NRLive depuis cette page pour le remettre.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Modèle d'origine (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Style</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Standard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Naturel</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">Cinématique</sys:String>
