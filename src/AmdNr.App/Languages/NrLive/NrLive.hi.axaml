<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Hindi. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveComingSoon">NRLive जल्द आ रहा है</sys:String>
  <sys:String x:Key="Str.NrLiveSubtitle">गेम को उसकी अपनी विंडो में दिखाता है, FSR से स्केल करके, ऊपर से फ़्रेम जनरेशन और NR के साथ, गेम की कोई फ़ाइल बदले बिना। एंटी-चीट वाले गेम के लिए, जिनमें कुछ भी इंजेक्ट नहीं किया जा सकता।</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} अभी इस PC पर नहीं है</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">लगभग {0}, एक बार इस ऐप के फ़ोल्डर में डाउनलोड होता है और बाकी हर फ़ाइल की तरह जाँचा जाता है। गेम में कुछ भी इंस्टॉल नहीं होता।</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">NRLive डाउनलोड करें</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} तैयार है</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">{0} पर अपडेट करें</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} आ गया है।</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive अभी OpenNR के लिए प्रकाशित नहीं हुआ है</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">यह एक पेलोड अपडेट के साथ आएगा, यहाँ कुछ भी दोबारा इंस्टॉल नहीं करना होगा। तब तक इसे इसकी अपनी रिलीज़ से चलाया जा सकता है।</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">इसकी रिलीज़</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">NRLive डाउनलोड नहीं हो सका: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">स्केलिंग सत्र</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">क्या कैप्चर करें</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">उलटी गिनती खत्म होने पर सामने वाली विंडो</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">अभी खुली कोई विंडो</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">लाइब्रेरी से कोई गेम</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">चुनने को कुछ नहीं</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">खुली विंडो फिर से पढ़ें</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">उलटी गिनती (से.)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">स्केल करें</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">शुरू हो रहा है · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">रोकें</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">जब आप तैयार हों</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">गेम पर जाएँ</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">स्केल हो रहा है</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">“स्केल करें” दबाएँ, फिर उलटी गिनती खत्म होने से पहले गेम पर जाएँ।</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">उलटी गिनती खत्म होते ही NRLive गेम की विंडो ले लेता है: अभी उस पर जाएँ।</sys:String>
  <sys:String x:Key="Str.NrLiveTitleWaiting">Waiting for the game</sys:String>
  <sys:String x:Key="Str.NrLiveStatusWaiting">Waiting for {0} to start… NRLive starts once its window is up.</sys:String>
  <sys:String x:Key="Str.NrLiveWaitGaveUp">{0} did not start in 5 minutes. Start the game, then press Scale again.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">“रोकें” दबाकर, या गेम के अंदर से {0} दबाकर, इसे बंद करें।</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">रुक गया।</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive बंद हो गया। वजह उसके फ़ोल्डर में NRLive.log में है।</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive शुरू नहीं हुआ: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive एडमिनिस्ट्रेटर के रूप में चल रहा है, इसलिए यह ऐप उसे नहीं रोक सकता: रोकने के लिए {0} दबाएँ।</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">एडमिनिस्ट्रेटर के रूप में चलाएँ</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">जो गेम एडमिनिस्ट्रेटर के रूप में चलता है, जैसे एंटी-चीट वाले ज़्यादातर गेम, वह NRLive से इनपुट तभी लेता है जब NRLive भी एडमिनिस्ट्रेटर के रूप में चले। Windows हर बार पूछता है।</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">स्केल, रोकने और ओवरले की हॉटकी अलग-अलग होनी चाहिए।</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">कोई हॉटकी ऐसी है जिसे NRLive पढ़ नहीं सकता। इसमें मॉडिफ़ायर और एक की होती है, जैसे ctrl+alt+s।</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">पासथ्रू की ऐसी होनी चाहिए जिन्हें NRLive पढ़ सके, कॉमा से अलग, जैसे home,insert।</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">पहले चुनें कि क्या कैप्चर करना है।</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows ने {0} नहीं लेने दिया: कोई दूसरा ऐप इसे इस्तेमाल कर रहा है। कोई और कॉम्बिनेशन चुनें।</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">NRLive की scaleconfig.ini में सेव होता है, जिसे उसका ओवरले भी बदलता है। बदलाव अगली बार “स्केल करें” दबाने से लागू होता है।</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">अपस्केलिंग और फ़्रेम</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">न्यूरल रेंडरिंग</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">ओवरले</sys:String>
  <sys:String x:Key="Str.NrLiveMore">और सेटिंग्स</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR को dlssnr-amd में NVIDIA का मॉडल चाहिए, और यह NRLive उसके बिना आया है। इसे अपनी DLL से कैसे निकालें, यह उसके फ़ोल्डर में DLSSNR-AMD-SETUP.txt में लिखा है।</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">NRLive का ओवरले (बार और काउंटर)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">कैप्चर</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">कैप्चर का स्रोत</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (डिफ़ॉल्ट)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, विंडो के हिसाब से क्रॉप</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">मोशन वेक्टर</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (डिफ़ॉल्ट)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD ऑप्टिकल फ़्लो</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">हॉटकी</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">किसी बॉक्स पर क्लिक करें और कॉम्बिनेशन दबाएँ। “स्केल और रोकें” हर जगह काम करता है, गेम में भी, जब तक यह ऐप खुला है।</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">स्केल और रोकें</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">ज़बरदस्ती रोकें</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">ओवरले</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">पासथ्रू की</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">वे की जो NRLive के बजाय गेम में OptiScaler या ReShade को भेजी जाती हैं, कॉमा से अलग।</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive को Caliel ने बनाया है और यह GPL-3.0 के तहत फ़्री सॉफ़्टवेयर है। इसका सोर्स कोड:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — Caliel द्वारा</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">एंटी-चीट वाले गेम के लिए, गेम को उसकी अपनी विंडो में स्केल करके दिखाता है। GPL-3.0 के तहत फ़्री सॉफ़्टवेयर; इसका सोर्स GitHub पर है।</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">इस गेम में {0} मिला</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">गेम में रखी गई DLL की वजह से एंटी-चीट अकाउंट बैन कर सकता है, और यहाँ इंस्टॉल के दोनों तरीके एक DLL रखते हैं। NRLive गेम की विंडो को बाहर से स्केल करता है, FSR, फ़्रेम जनरेशन और NR के साथ, और उसके फ़ोल्डर में कुछ नहीं बदलता।</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">NRLive इस्तेमाल करें</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">इस गेम के लिए अनदेखा करें</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
