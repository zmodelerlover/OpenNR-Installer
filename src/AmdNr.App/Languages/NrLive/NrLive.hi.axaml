  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU लोड</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU तापमान</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU लोड</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR, NR और FG की स्थिति</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">हर पास का GPU समय</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">HUD का आकार</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">गेम के फ़्रेम और गति कैसे पढ़े जाते हैं</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">स्क्रीन पर दिखता है (बदलने के लिए क्लिक करें)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">HUD पूर्वावलोकन</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">गेम के हर दो फ़्रेम के बीच एक नया फ़्रेम</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">किसकी सेटिंग्स</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">ग्लोबल</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (ग्लोबल सेटिंग्स)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">ग्लोबल सेटिंग्स इस्तेमाल करें</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">{0} की सेटिंग्स हटाकर ग्लोबल सेटिंग्स पर लौटता है।</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">लाइब्रेरी के किसी गेम को अपनी सेटिंग्स तब मिलती हैं जब उसके यहाँ दिखाए जाने के दौरान आप पहली बार कोई सेटिंग बदलते हैं। उलटी गिनती किसी विंडो पर खत्म हो, तो उसके गेम की सेटिंग्स लागू होती हैं, अगर उसकी अपनी हों। क्या कैप्चर करना है, उलटी गिनती, स्केल हॉटकी और एडमिनिस्ट्रेटर के रूप में चलाना सभी गेम के लिए एक जैसे रहते हैं।</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">सेटिंग्स: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">सेटिंग्स: {0}। इसका अपस्केलर, कैप्चर और कुंजियाँ तब लागू होती हैं जब इसे लक्ष्य के रूप में चुना जाए।</sys:String>
  <!-- The look and encoding keys, grouped as in OptiScaler's menu -->
  <sys:String x:Key="Str.NrLiveGroup.composition">कंपोज़िशन</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.composition.Hint">मॉडल का जवाब फ़्रेम में वापस कैसे रखा जाता है।</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look">NR का लुक बदलें</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look.Hint">कंपोज़ करने से पहले मॉडल के बदलाव को एडिट करता है: कितना उजला, गहरा और रंगीन करता है।</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding">एन्कोडिंग</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding.Hint">HDR फ़्रेम के लिए। NRLive 8-bit SDR कैप्चर करता है और रनटाइम अपने SDR पथ पर रहता है, इसलिए अभी इनसे बहुत कम या कोई बदलाव नहीं होता। कर्व, जिनमें AgX भी है, Preprocess में हैं।</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess">प्रीप्रोसेस</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess.Hint">नेटवर्क को दिखाई जाने वाली तस्वीर बदलता है (एक्सपोज़र, कर्व, कंट्रास्ट, सैचुरेशन) और उसके जवाब से वापस निकाल देता है, इसलिए नेटवर्क फ़्रेम को कैसे एडिट करता है, यह बदल जाता है।</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4">int4 मिक्स्ड नेटवर्क (ओरिजिनल मॉडल)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4.Off">सिर्फ़ 310.8 मॉडल से बना है, इसलिए नए Small मॉडल पर नहीं चलता। ओरिजिनल मॉडल पर लौटने तक आपकी पसंद सुरक्षित रहती है।</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiNoiseEveryFrame">मोशन वेक्टर के बिना नॉइज़ बदलें</sys:String>
