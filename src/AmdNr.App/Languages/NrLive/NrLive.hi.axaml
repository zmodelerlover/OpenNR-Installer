  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">रेज़ोल्यूशन</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">बैकग्राउंड</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">टेक्स्ट आउटलाइन</sys:String>
