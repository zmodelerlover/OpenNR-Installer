  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">फ़्रेम काउंटर</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">काउंटर की जगह</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">ऊपर बाएँ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">ऊपर दाएँ</sys:String>
