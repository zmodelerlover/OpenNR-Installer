<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Croatian. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Prikazuje igru u zasebnom prozoru, skaliranu s FSR-om, uz generiranje sličica i NR, bez mijenjanja ijedne datoteke igre. Za igre s anti-cheatom, u koje se ništa ne smije ubaciti.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} još nije na ovom računalu</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Oko {0}, preuzima se jednom u mapu ove aplikacije i provjerava kao svaka druga datoteka. U igru se ništa ne instalira.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Preuzmi NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} je spreman</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Ažuriraj na {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">Izašao je NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive još nije objavljen za OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Stiže s ažuriranjem datoteka, bez ponovne instalacije ičega ovdje. Do tada radi iz vlastitog izdanja.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Njegova izdanja</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">NRLive se nije mogao preuzeti: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Sesija skaliranja</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Što snimati</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Prozor u prvom planu kad odbrojavanje završi</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Trenutačno otvoren prozor</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Igra iz biblioteke</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nema se što odabrati</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Ponovno očitaj otvorene prozore</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Odbrojavanje (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Skaliraj</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Pokretanje · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Zaustavi</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Spremno kad i vi</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Prebacite se na igru</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Skaliranje</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Pritisnite „Skaliraj”, a zatim se prebacite na igru prije kraja odbrojavanja.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive preuzima prozor igre kad odbrojavanje završi: prebacite se na nju sada.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Završava se tipkom „Zaustavi” ili prečacem {0} iz igre.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Zaustavljeno.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive se zatvorio. Razlog je u NRLive.log u njegovoj mapi.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive se nije pokrenuo: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive radi kao administrator, izvan dosega ove aplikacije: pritisnite {0} da ga zaustavite.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Pokreni kao administrator</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Igra koja radi kao administrator, kao većina igara s anti-cheatom, prima unos preko NRLivea samo ako i NRLive radi kao administrator. Windows pita svaki put.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Prečaci za skaliranje, zaustavljanje i overlay moraju se međusobno razlikovati.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">NRLive ne može pročitati jedan od prečaca. Prihvaća modifikatore i jednu tipku, npr. ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Propuštene tipke moraju biti tipke koje NRLive može pročitati, odvojene zarezima, npr. home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Najprije odaberite što snimati.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows nije prihvatio {0}: koristi ga druga aplikacija. Odaberite drugu kombinaciju.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Sprema se u NRLiveov scaleconfig.ini, koji uređuje i njegov overlay. Promjena vrijedi od sljedećeg pritiska na „Skaliraj”.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Skaliranje i sličice</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Neuronsko renderiranje</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Više postavki</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR treba NVIDIA model u dlssnr-amd, a ovaj je NRLive stigao bez njega. DLSSNR-AMD-SETUP.txt u njegovoj mapi objašnjava kako ga izvući iz vlastitog DLL-a.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">NRLive overlay (traka i brojač)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Snimanje</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Izvor snimanja</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (zadano)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, obrezano na prozor</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Vektori pokreta</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (zadano)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD optički tok</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Prečaci</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Kliknite polje i pritisnite kombinaciju. „Skaliraj i zaustavi” radi svugdje, i u igri, dok je ova aplikacija otvorena.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Skaliraj i zaustavi</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Prisilno zaustavi</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Propuštene tipke</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Tipke koje u igri idu OptiScaleru ili ReShadeu umjesto NRLiveu, odvojene zarezima.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive izrađuje Caliel i slobodan je softver pod licencom GPL-3.0. Izvorni kod:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive, autor Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Prikazuje skaliranu igru u zasebnom prozoru, za igre s anti-cheatom. Slobodan softver pod licencom GPL-3.0; izvorni kod je na GitHubu.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">U ovoj je igri pronađen {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Anti-cheat može zabraniti račun zbog DLL-a stavljenog u igru, a oba načina instalacije ovdje stavljaju jedan. NRLive skalira prozor igre izvana, s FSR-om, generiranjem sličica i NR-om, i ne mijenja ništa u njezinoj mapi.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Koristi NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Zanemari za ovu igru</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Oštrina</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Generiranje sličica</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Ograničenje sličica</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Ograniči na</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Način ograničavanja</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Glatko</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Niska latencija</sys:String>
