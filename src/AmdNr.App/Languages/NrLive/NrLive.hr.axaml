  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Struktura kože</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Maska likova</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Koža odvojena od strukture</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Boja iz NR-a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Jačina povijesti</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Vremenska povijest</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Gradacija stila</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">ACO prevoditelj shadera (od sljedećeg pokretanja)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">HUD predložak</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Prilagođeno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Minimalno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Kompaktno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Standardno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Potpuno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Gore u sredini</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Dolje u sredini</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">Najniži 1% i 0,1%</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">Opterećenje GPU-a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">Temperatura GPU-a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">Opterećenje CPU-a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">Stanje FSR-a, NR-a i FG-a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">GPU vrijeme svakog prolaza</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">Veličina HUD-a</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Kako se čitaju sličice i pokret igre</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">Na zaslonu (kliknite za uključivanje)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">Pregled HUD-a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Jedna sličica između svake dvije koje igra iscrta</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">Postavke za</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">Globalno</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (globalne postavke)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">Koristi globalne postavke</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">Briše postavke za {0} i vraća globalne.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">Igra iz biblioteke dobiva vlastite postavke kad prvi put promijenite neku dok je ovdje prikazana. Kad odbrojavanje završi na prozoru, vrijede postavke njegove igre ako ih ima. Što se snima, odbrojavanje, prečac za skaliranje i pokretanje kao administrator isti su za sve igre.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">Postavke: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">Postavke: {0}. Njezin upscaler, snimanje i tipke vrijede kad je odabrana kao cilj.</sys:String>
  <!-- The look and encoding keys, grouped as in OptiScaler's menu -->
  <sys:String x:Key="Str.NrLiveGroup.composition">Kompozicija</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.composition.Hint">Kako se odgovor modela vraća u sliku.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look">Podesi izgled NR-a</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look.Hint">Uređuje promjenu modela prije slaganja: koliko posvjetljuje, zatamnjuje i boji.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding">Kodiranje</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding.Hint">Za HDR slike. NRLive snima 8-bit SDR, a runtime ostaje na SDR putu, pa ovo zasad mijenja malo ili ništa. Krivulje, među njima AgX, nalaze se pod Pretprocesiranje.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess">Predobrada</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess.Hint">Mijenja sliku koja se prikazuje mreži (ekspozicija, krivulja, kontrast, zasićenost) i poništava to u njezinu odgovoru, pa mijenja kako mreža uređuje sliku.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4">int4 miješana mreža (Originalni model)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4.Off">Napravljena samo od modela 310.8, pa ne radi na novom Small modelu. Tvoj izbor ostaje sačuvan za povratak na Originalni model.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiNoiseEveryFrame">Mijenjaj šum bez vektora kretanja</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferStrength">Zadržana promjena svjetline</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoChromaClamp">Najveća promjena boje</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferMode">Način prijenosa</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferMode.0">Ograničeni omjer</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferMode.1">Dosljedno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyleHighlightGuard">Zaštita svjetlina (HDR)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoDetailStability">Stabilnost detalja</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoDetailStability.0">Automatski</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoDetailStability.1">Isključeno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoDetailStability.2">Uvijek</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore">Obnova SDR crne</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore.0">Automatski</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore.1">Svaki blok</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSdrBlackRestore.2">Glatko</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoDisplayPedestal">HDR tamni podložak</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoDisplayPedestal.0">Automatski</sys:String>
