  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">NR treba NVIDIA model u mapi opennr, a njega tamo nema. Ponovno preuzmi NRLive s ove stranice da ga vratiš.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Izvorni model (310.8)</sys:String>
