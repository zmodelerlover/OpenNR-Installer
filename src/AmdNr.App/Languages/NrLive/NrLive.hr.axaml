  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Sam pronalazi kožu</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilizator</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Brojač sličica</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Položaj brojača</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Gore lijevo</sys:String>
