<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Hungarian. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveComingSoon">Az NRLive hamarosan érkezik</sys:String>
  <sys:String x:Key="Str.NrLiveSubtitle">A játékot saját ablakban jeleníti meg, FSR-rel felskálázva, képkocka-generálással és NR-rel, a játék egyetlen fájljának módosítása nélkül. Anti-cheattel védett játékokhoz, amelyekbe semmit sem szabad injektálni.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">Az NRLive {0} még nincs ezen a gépen</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Kb. {0}, egyszer töltődik le az alkalmazás mappájába, és ugyanúgy ellenőrizve van, mint minden más fájl. Semmi sem települ a játékba.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">NRLive letöltése</sys:String>
  <sys:String x:Key="Str.NrLiveReady">Az NRLive {0} kész</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Frissítés erre: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">Megjelent az NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">Az NRLive még nem jelent meg az OpenNR-hez</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Egy fájlfrissítéssel érkezik, itt semmit sem kell újratelepíteni. Addig a saját kiadásából fut.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Kiadásai</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Az NRLive-ot nem sikerült letölteni: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Skálázási munkamenet</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Mit rögzítsen</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Az előtérben lévő ablak a visszaszámlálás végén</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Egy most nyitott ablak</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Egy játék a könyvtárból</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nincs mit választani</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Nyitott ablakok újraolvasása</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Visszaszámlálás (mp)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Skálázás</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Indítás · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Leállítás</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Indulhat, amikor szeretnéd</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Válts a játékra</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Skálázás folyamatban</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Nyomd meg a „Skálázás” gombot, majd válts a játékra a visszaszámlálás vége előtt.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">A visszaszámlálás végén az NRLive átveszi a játék ablakát: válts rá most.</sys:String>
  <sys:String x:Key="Str.NrLiveTitleWaiting">Waiting for the game</sys:String>
  <sys:String x:Key="Str.NrLiveStatusWaiting">Waiting for {0} to start… NRLive starts once its window is up.</sys:String>
  <sys:String x:Key="Str.NrLiveWaitGaveUp">{0} did not start in 5 minutes. Start the game, then press Scale again.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">A „Leállítás” gombbal vagy a játékból a(z) {0} billentyűkombinációval állítható le.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Leállítva.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">Az NRLive bezárult. Az okát a mappájában lévő NRLive.log tartalmazza.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">Az NRLive nem indult el: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">Az NRLive rendszergazdaként fut, ez az alkalmazás nem fér hozzá: a leállításhoz nyomd meg ezt: {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Futtatás rendszergazdaként</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">A rendszergazdaként futó játék – márpedig az anti-cheattel védettek többsége ilyen – csak akkor kap bemenetet az NRLive-on keresztül, ha az NRLive is rendszergazdaként fut. A Windows minden alkalommal rákérdez.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">A skálázás, a leállítás és az overlay gyorsbillentyűinek különbözniük kell.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Az egyik gyorsbillentyűt az NRLive nem tudja értelmezni. Módosítóbillentyűket és egyetlen billentyűt fogad el, például: ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Az átengedett billentyűk csak olyanok lehetnek, amelyeket az NRLive értelmezni tud, vesszővel elválasztva, például: home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Először válaszd ki, mit rögzítsen.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">A Windows nem engedte ezt: {0}, egy másik alkalmazás már használja. Válassz másik kombinációt.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Az NRLive scaleconfig.ini fájljába kerül, amelyet az overlayje is szerkeszt. A változás a „Skálázás” következő megnyomásától érvényes.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Felskálázás és képkockák</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Neurális renderelés</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">További beállítások</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">Az NR-hez az NVIDIA modellje kell a dlssnr-amd mappában, ez az NRLive viszont nélküle érkezett. A mappájában lévő DLSSNR-AMD-SETUP.txt leírja, hogyan nyerheted ki a saját DLL-edből.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Az NRLive overlayje (sáv és számláló)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Rögzítés</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Rögzítés forrása</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (alapértelmezett)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, az ablakra vágva</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Mozgásvektorok</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (alapértelmezett)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD optikai áramlás</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Gyorsbillentyűk</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Kattints egy mezőbe, és nyomd meg a kombinációt. A „Skálázás és leállítás” mindenhol működik, a játékban is, amíg ez az alkalmazás nyitva van.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Skálázás és leállítás</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Kényszerített leállítás</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Átengedett billentyűk</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Billentyűk, amelyek az NRLive helyett a játékban futó OptiScalerhez vagy ReShade-hez jutnak, vesszővel elválasztva.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">Az NRLive-ot Caliel készíti, és GPL-3.0 licencű szabad szoftver. A forráskódja:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — Caliel munkája</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Felskálázva, saját ablakban jeleníti meg a játékot, anti-cheattel védett játékokhoz. GPL-3.0 licencű szabad szoftver; a forráskódja a GitHubon van.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">Ebben a játékban ez található: {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Az anti-cheat kitilthatja a fiókot a játékba tett DLL miatt, és az itteni mindkét telepítési mód tesz be egyet. Az NRLive kívülről skálázza a játék ablakát, FSR-rel, képkocka-generálással és NR-rel, és semmit sem módosít a játék mappájában.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">NRLive használata</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Kihagyás ennél a játéknál</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Élesség</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Képkocka-generálás</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Képkockakorlát</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Korlát</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Korlátozó időzítése</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Egyenletes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Alacsony késleltetés</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">NR futtatókörnyezet</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Automatikus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">Az NRLive 0.0.6-os hídja</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Modell</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Eredeti</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Új, gyorsabb</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Stílus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Semleges</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Természetes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Filmszerű</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Az NR felbontása</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intenzitás</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Menetek</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Struktúra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Szín az NR-ből</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Helyi tónus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Maximális arány</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Bőrstruktúra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Előzmények erőssége</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Bőr automatikus felismerése</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilizátor</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Képkockaszámláló</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Számláló helye</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Bal felső</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Jobb felső</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Bal alsó</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Jobb alsó</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Képkocka másodpercenként</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Képkockaidő</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Képkockaidő-grafikon</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Felbontás</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Háttér</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Szöveg körvonala</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Szövegméret</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Háttér átlátszatlansága</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Felskálázó</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">Nincs (natív skálázás)</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">Az NR-hez az NVIDIA modellje kell az opennr mappában, de nincs ott. Töltsd le újra az NRLive-ot erről az oldalról, hogy visszakerüljön.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Eredeti modell (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Stílus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Normál</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Természetes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">Filmszerű</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">Intenzitás</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">Menetek</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">Helyi tónus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Helyi struktúra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Bőrstruktúra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Karaktermaszk</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Bőr a struktúrától külön</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Szín az NR-ből</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Előzmények erőssége</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Időbeli előzmények</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Stílus színkorrekciója</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">ACO shaderfordító (a következő indítástól)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">HUD-előbeállítás</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Egyéni</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Minimális</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Kompakt</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Normál</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Teljes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Felül középen</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Alul középen</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1%-os és 0,1%-os mélypontok</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU terhelés</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU hőmérséklet</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU terhelés</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR, NR és FG állapota</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Menetenkénti GPU-idő</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">HUD mérete</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Hogyan olvassa a játék képkockáit és mozgását</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">A képernyőn (kattintson a váltáshoz)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">HUD-előnézet</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Egy képkocka a játék által rajzolt minden kettő között</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">Beállítások ehhez</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">Globális</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (globális beállítások)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">Globális beállítások használata</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">Törli a(z) {0} beállításait, és visszatér a globálisakhoz.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">A könyvtár egy játéka akkor kap saját beállításokat, amikor először módosítasz egyet, miközben itt látszik. Ha a visszaszámlálás egy ablakon ér véget, a játékának beállításai érvényesek, ha vannak neki. Hogy mit rögzít, a visszaszámlálás, a skálázás gyorsbillentyűje és a rendszergazdaként futtatás minden játékra ugyanaz.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">Beállítások: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">Beállítások: {0}. A felskálázója, a rögzítés és a billentyűk akkor érvényesek, ha célként választod ki.</sys:String>
  <!-- The look and encoding keys, grouped as in OptiScaler's menu -->
  <sys:String x:Key="Str.NrLiveGroup.composition">Összeállítás</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.composition.Hint">Hogyan kerül vissza a modell válasza a képkockába.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look">NR megjelenésének módosítása</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look.Hint">A modell változtatását szerkeszti az összeállítás előtt: mennyire világosít, sötétít és színez.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding">Kódolás</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding.Hint">Minek tekinti a rendszer a rögzített képkockát. „A formátumból” megtartja az NRLive szokásos SDR útvonalát; az SDR, Linear vagy PQ választása a HDR kodekre vált, és az itt jelölt beállítások hatásba lépnek.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess">Előfeldolgozás</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess.Hint">Megváltoztatja a hálónak mutatott képet (expozíció, görbe, kontraszt, telítettség), és a válaszából visszavonja, így módosul, hogyan szerkeszti a háló a képkockát.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4">int4 vegyes háló (Eredeti modell)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4.Off">Csak a 310.8 modellből készült, ezért az új Small modellen nem fut. A választásod megmarad arra az esetre, ha visszatérsz az Eredeti modellhez.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiNoiseEveryFrame">Zaj változtatása mozgásvektorok nélkül</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferStrength">Megtartott fényerőváltozás</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoChromaClamp">Legnagyobb színváltozás</sys:String>
