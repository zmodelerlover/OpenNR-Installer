  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Helyi tónus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Maximális arány</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Bőrstruktúra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Előzmények erőssége</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Bőr automatikus felismerése</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilizátor</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Képkockaszámláló</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Számláló helye</sys:String>
