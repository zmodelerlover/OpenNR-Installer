  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Kompakt</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Normál</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Teljes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Felül középen</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Alul középen</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1%-os és 0,1%-os mélypontok</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU terhelés</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU hőmérséklet</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU terhelés</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR, NR és FG állapota</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Menetenkénti GPU-idő</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">HUD mérete</sys:String>
