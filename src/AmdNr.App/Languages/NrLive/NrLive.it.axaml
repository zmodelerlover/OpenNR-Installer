<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Italian. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Mostra un gioco in una finestra tutta sua, scalato con FSR, con generazione dei frame e NR sopra, senza modificare nessun file del gioco. Per i giochi con anti-cheat, dove non si può iniettare nulla.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} non è ancora su questo PC</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Circa {0}, scaricato una sola volta nella cartella di questa app e verificato come ogni altro file. Nei giochi non viene installato nulla.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Scarica NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} è pronto</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Aggiorna a {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">È uscito NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive non è ancora pubblicato per OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Arriverà con un aggiornamento dei file, senza reinstallare nulla qui. Nel frattempo funziona dalla sua release.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Le sue release</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Impossibile scaricare NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Sessione di scaling</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Cosa catturare</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">La finestra in primo piano allo scadere del conto alla rovescia</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Una finestra aperta ora</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Un gioco della libreria</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Niente da scegliere</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Rileggi le finestre aperte</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Conto alla rovescia (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Scala</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Avvio · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Ferma</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Pronto quando vuoi</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Passa al gioco</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Scaling attivo</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Premi Scala, poi passa al gioco prima che finisca il conto alla rovescia.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive prende la finestra del gioco quando finisce il conto alla rovescia: passaci adesso.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Ferma, oppure {0} dall'interno del gioco, lo termina.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Fermato.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive si è chiuso. Il motivo è in NRLive.log, nella sua cartella.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive non si è avviato: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive è in esecuzione come amministratore, fuori dalla portata di questa app: premi {0} per fermarlo.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Esegui come amministratore</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Un gioco eseguito come amministratore, come la maggior parte di quelli con anti-cheat, riceve l'input tramite NRLive solo se anche NRLive è eseguito come amministratore. Windows lo chiede ogni volta.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Le scorciatoie per scalare, fermare e overlay devono essere tutte diverse.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Una scorciatoia non è leggibile da NRLive. Accetta modificatori e un tasto, come ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">I tasti inoltrati devono essere tasti che NRLive sa leggere, separati da virgole, come home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Prima scegli cosa catturare.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows non ha accettato {0}: la usa già un'altra app. Scegli un'altra combinazione.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Salvato nello scaleconfig.ini di NRLive, che anche il suo overlay modifica. Una modifica vale dalla prossima volta che si preme Scala.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Upscaling e frame</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Rendering neurale</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Altre impostazioni</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR ha bisogno del modello di NVIDIA in dlssnr-amd, e questo NRLive ne è privo. DLSSNR-AMD-SETUP.txt nella sua cartella spiega come estrarlo dalla tua DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Overlay di NRLive (barra e contatore)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Cattura</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Sorgente di cattura</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (predefinito)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, ritagliato sulla finestra</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Vettori di movimento</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (predefinito)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Flusso ottico AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Scorciatoie</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Clicca su una casella e premi la combinazione. Scala e ferma funziona ovunque, anche nel gioco, finché questa app è aperta.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Scala e ferma</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Arresto forzato</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Tasti inoltrati</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Tasti passati a OptiScaler o ReShade nel gioco invece che a NRLive, separati da virgole.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive è creato da Caliel ed è software libero sotto GPL-3.0. Il suo codice sorgente:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — di Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Mostra un gioco scalato in una finestra tutta sua, per i giochi con anti-cheat. Software libero sotto GPL-3.0; il codice è su GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">{0} trovato in questo gioco</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Un anti-cheat può bannare l'account per una DLL messa nel gioco, ed entrambi i modi di installare da qui ne mettono una. NRLive scala la finestra del gioco dall'esterno, con FSR, generazione dei frame e NR, e non cambia nulla nella sua cartella.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Usa NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Ignora per questo gioco</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.2">Nessuno</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Nitidezza</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Generazione dei frame</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Limite dei frame</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Limita a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Cadenza del limitatore</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Fluida</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Bassa latenza</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Runtime NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Quello di NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Modello</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Originale</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Nuovo, più veloce</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Stile</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutro</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Naturale</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Cinematografico</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Risoluzione a cui gira NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensità</sys:String>
  <sys:String x:Key="Str.NrLiveSet.RenoDX.enabled">Look RenoDX</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Passate</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Struttura</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Colore da NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Tono locale</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Rapporto massimo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Struttura della pelle</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Forza della cronologia</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Rileva la pelle da solo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilizzatore</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Contatore dei frame</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Posizione del contatore</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">In alto a sinistra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">In alto a destra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">In basso a sinistra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">In basso a destra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu">Carico e temperatura della GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Frame al secondo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Frame time</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Grafico del frame time</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Risoluzione</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Sfondo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Contorno del testo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Dimensione del testo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Opacità dello sfondo</sys:String>

</ResourceDictionary>
