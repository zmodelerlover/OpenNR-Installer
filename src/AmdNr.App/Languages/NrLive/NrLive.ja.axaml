<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Japanese. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">ゲームを専用のウィンドウで表示し、FSR でスケーリングして、フレーム生成と NR を重ねます。ゲームのファイルは一切変更しません。何も注入できない、アンチチート付きのゲーム向けです。</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} はまだこの PC にありません</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">約 {0}。このアプリのフォルダーに一度だけダウンロードされ、他のファイルと同じように検証されます。ゲームには何もインストールされません。</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">NRLive をダウンロード</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} の準備ができました</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">{0} にアップデート</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} が公開されました。</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive はまだ OpenNR 向けに公開されていません</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">ファイルのアップデートで届くので、ここで再インストールする必要はありません。それまでは NRLive 自身のリリースから実行できます。</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">リリース一覧</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">NRLive をダウンロードできませんでした：{0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">スケーリングセッション</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">キャプチャ対象</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">カウントダウン終了時に最前面にあるウィンドウ</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">今開いているウィンドウ</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">ライブラリのゲーム</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">選択できるものがありません</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">開いているウィンドウを再読み込み</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">カウントダウン（秒）</sys:String>
  <sys:String x:Key="Str.NrLiveScale">スケーリング</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">開始中 · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">停止</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">準備完了</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">ゲームに切り替えてください</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">スケーリング中</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">「スケーリング」を押し、カウントダウンが終わる前にゲームに切り替えてください。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">カウントダウンが終わると NRLive がゲームのウィンドウを取り込みます。今すぐ切り替えてください。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">「停止」を押すか、ゲーム内で {0} を押すと終了します。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">停止しました。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive が終了しました。理由は NRLive のフォルダーにある NRLive.log に記録されています。</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive を起動できませんでした：{0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive は管理者として実行されているため、このアプリからは操作できません。{0} を押して停止してください。</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">管理者として実行</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">管理者として実行されるゲーム（アンチチート付きのゲームの多くがそうです）は、NRLive も管理者として実行しないと NRLive 経由で入力を受け付けません。Windows が毎回確認します。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">スケーリング、停止、オーバーレイのホットキーはすべて別々にしてください。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">NRLive が読み取れないホットキーがあります。修飾キーとキー 1 つの組み合わせにしてください（例：ctrl+alt+s）。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">パススルーキーは NRLive が読み取れるキーをカンマ区切りで指定してください（例：home,insert）。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">先にキャプチャ対象を選んでください。</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows が {0} を登録できませんでした。別のアプリが使用しています。別の組み合わせを選んでください。</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">NRLive の scaleconfig.ini に保存されます。このファイルは NRLive のオーバーレイからも編集されます。変更は次に「スケーリング」を押したときから反映されます。</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">アップスケーリングとフレーム</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">ニューラルレンダリング</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">オーバーレイ</sys:String>
  <sys:String x:Key="Str.NrLiveMore">その他の設定</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR には dlssnr-amd に NVIDIA のモデルが必要ですが、この NRLive には含まれていません。NRLive のフォルダーにある DLSSNR-AMD-SETUP.txt に、お持ちの DLL から取り出す方法が書かれています。</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">NRLive のオーバーレイ（バーとカウンター）</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">キャプチャ</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">キャプチャ方式</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture（既定）</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI（ウィンドウに合わせて切り抜き）</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">モーションベクトル</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV（既定）</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD オプティカルフロー</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">ホットキー</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">ボックスをクリックして組み合わせを押してください。このアプリが開いている間、「スケーリングと停止」はゲーム内を含めどこでも使えます。</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">スケーリングと停止</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">強制停止</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">オーバーレイ</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">パススルーキー</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">NRLive ではなくゲーム内の OptiScaler や ReShade に渡すキーです。カンマで区切ります。</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive は Caliel が作った、GPL-3.0 のフリーソフトウェアです。ソースコード：</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive（作者：Caliel）</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">アンチチート付きのゲーム向けに、ゲームを専用のウィンドウでスケーリングして表示します。GPL-3.0 のフリーソフトウェアで、ソースは GitHub にあります。</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">このゲームで {0} が見つかりました</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">アンチチートは、ゲームに置かれた DLL を理由にアカウントを BAN することがあります。ここにある 2 つのインストール方法は、どちらも DLL を置きます。NRLive はゲームのウィンドウを外側から FSR、フレーム生成、NR でスケーリングし、ゲームのフォルダーには何も手を加えません。</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">NRLive を使う</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">このゲームでは表示しない</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode">アップスケーラー</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.2">なし</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">シャープネス</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">フレーム生成</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">フレームレート制限</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">上限</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">制限のタイミング</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">なめらか</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">低遅延</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">NR ランタイム</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">NRLive 内蔵</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">モデル</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">オリジナル</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">新しい高速版</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">スタイル</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">ニュートラル</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">ナチュラル</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">シネマティック</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">NR の処理解像度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">強さ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.RenoDX.enabled">RenoDX の色味</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">パス数</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">ディテール</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">NR の色</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">ローカルトーン</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">最大比率</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">肌のディテール</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">履歴の強さ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">肌を自動で検出</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">スタビライザー</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">フレームカウンター</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">カウンターの位置</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">左上</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">右上</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">左下</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">右下</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu">GPU 使用率と温度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">フレームレート</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">フレームタイム</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">フレームタイムグラフ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">解像度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">背景</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">文字の縁取り</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">文字サイズ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">背景の不透明度</sys:String>

</ResourceDictionary>
