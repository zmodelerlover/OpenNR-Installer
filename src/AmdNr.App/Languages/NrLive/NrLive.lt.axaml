<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Lithuanian. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveComingSoon">NRLive jau netrukus</sys:String>
  <sys:String x:Key="Str.NrLiveSubtitle">Rodo žaidimą atskirame lange, padidintą su FSR, su kadrų generavimu ir NR, nekeisdama nė vieno žaidimo failo. Žaidimams su anti-cheat, į kuriuos nieko negalima įterpti.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} šiame kompiuteryje dar nėra</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Apie {0}, atsisiunčiama vieną kartą į šios programos aplanką ir patikrinama kaip kiekvienas kitas failas. Į žaidimą niekas neįdiegiama.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Atsisiųsti NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} paruošta</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Atnaujinti į {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">Išleista NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive dar neišleista OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Ji atkeliaus su failų naujiniu, čia nieko nereikės įdiegti iš naujo. Iki tol ji veikia iš savo leidimo.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Jos leidimai</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Nepavyko atsisiųsti NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Didinimo seansas</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Ką fiksuoti</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Priekyje esantis langas, kai baigiasi atgalinis skaičiavimas</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Dabar atidarytas langas</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Žaidimas iš bibliotekos</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nėra ką pasirinkti</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Iš naujo nuskaityti atidarytus langus</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Atgalinis skaičiavimas (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Didinti</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Paleidžiama · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Stabdyti</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Paruošta, kai tik norėsite</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Persijunkite į žaidimą</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Didinama</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Paspauskite „Didinti“, tada persijunkite į žaidimą, kol nesibaigė atgalinis skaičiavimas.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">Pasibaigus atgaliniam skaičiavimui, NRLive perims žaidimo langą: persijunkite į jį dabar.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Sustabdykite mygtuku „Stabdyti“ arba žaidime paspaudę {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Sustabdyta.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive užsidarė. Priežastis – faile NRLive.log jos aplanke.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive nepasileido: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive veikia kaip administratorius, ši programa jos nepasiekia: paspauskite {0}, kad ją sustabdytumėte.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Paleisti kaip administratorių</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Žaidimas, veikiantis kaip administratorius (taip veikia dauguma žaidimų su anti-cheat), per NRLive priima įvestį tik tada, kai ir NRLive veikia kaip administratorius. Windows klaus kiekvieną kartą.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Didinimo, stabdymo ir perdangos spartieji klavišai turi skirtis.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Vieno sparčiojo klavišo NRLive negali nuskaityti. Ji priima modifikatorius ir vieną klavišą, pvz., ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Praleidžiami klavišai turi būti tokie, kuriuos NRLive gali nuskaityti, atskirti kableliais, pvz., home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Pirmiausia pasirinkite, ką fiksuoti.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows nepriėmė {0}: jį naudoja kita programa. Pasirinkite kitą derinį.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Įrašoma į NRLive failą scaleconfig.ini, kurį redaguoja ir jos perdanga. Pakeitimas galioja nuo kito „Didinti“ paspaudimo.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Didinimas ir kadrai</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Neuroninis atvaizdavimas</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Perdanga</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Daugiau nustatymų</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR reikia NVIDIA modelio aplanke dlssnr-amd, o ši NRLive atkeliavo be jo. Jos aplanke esantis DLSSNR-AMD-SETUP.txt paaiškina, kaip jį išgauti iš savo DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">NRLive perdanga (juosta ir skaitiklis)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Fiksavimas</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Fiksavimo šaltinis</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (numatytasis)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, apkirpta pagal langą</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Judesio vektoriai</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (numatytasis)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD optinis srautas</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Spartieji klavišai</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Spustelėkite laukelį ir paspauskite derinį. „Didinti ir stabdyti“ veikia visur, ir žaidime, kol ši programa atidaryta.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Didinti ir stabdyti</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Priverstinai stabdyti</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Perdanga</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Praleidžiami klavišai</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Klavišai, perduodami žaidime veikiančiam OptiScaler ar ReShade, o ne NRLive, atskirti kableliais.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive kuria Caliel; tai laisvoji programinė įranga pagal GPL-3.0 licenciją. Jos išeitinis kodas:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Rodo padidintą žaidimą atskirame lange, žaidimams su anti-cheat. Laisvoji programinė įranga pagal GPL-3.0 licenciją; išeitinis kodas yra GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">Šiame žaidime rasta {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Anti-cheat gali užblokuoti paskyrą dėl į žaidimą įdėto DLL, o abu čia esantys diegimo būdai tokį įdeda. NRLive didina žaidimo langą iš išorės, su FSR, kadrų generavimu ir NR, ir nieko nekeičia žaidimo aplanke.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Naudoti NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Nepaisyti šiame žaidime</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Ryškumas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Kadrų generavimas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Kadrų riba</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Riboti iki</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Ribotuvo režimas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Tolygus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Maža delsa</sys:String>
