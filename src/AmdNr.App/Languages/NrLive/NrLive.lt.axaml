  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Vietinė struktūra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Odos struktūra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Veikėjų kaukė</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Oda atskirai nuo struktūros</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Spalva iš NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Istorijos stiprumas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Laikinė istorija</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Stiliaus spalvinimas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">ACO šešėliuoklių kompiliatorius (nuo kito paleidimo)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">HUD rinkinys</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Pasirinktinis</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Minimalus</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Kompaktiškas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Standartinis</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Pilnas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Viršuje centre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Apačioje centre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1% ir 0,1% žemumos</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU apkrova</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU temperatūra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU apkrova</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR, NR ir FG būsena</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Kiekvieno praėjimo GPU laikas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">HUD dydis</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Kaip skaitomi žaidimo kadrai ir judesys</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">Rodoma ekrane (spustelėkite perjungti)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">HUD peržiūra</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Vienas kadras tarp kiekvienų dviejų, kuriuos piešia žaidimas</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">Kieno nustatymai</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">Bendri</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (bendri nustatymai)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">Naudoti bendrus nustatymus</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">Ištrina žaidimo „{0}“ nustatymus ir grįžta prie bendrų.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">Žaidimas iš bibliotekos gauna savo nustatymus, kai pirmą kartą pakeičiate kurį nors iš jų, kol jis čia rodomas. Kai atgalinis skaičiavimas baigiasi ant lango, galioja jo žaidimo nustatymai, jei jis jų turi. Ką fiksuoti, atgalinis skaičiavimas, didinimo spartusis klavišas ir paleidimas administratoriaus teisėmis visiems žaidimams vienodi.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">Nustatymai: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">Nustatymai: {0}. Jo didinimo algoritmas, fiksavimas ir klavišai galioja, kai jis pasirinktas kaip tikslas.</sys:String>

</ResourceDictionary>
