  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Kadro laiko grafikas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Raiška</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Fonas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Teksto kontūras</sys:String>
