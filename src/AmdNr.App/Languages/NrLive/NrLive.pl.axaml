<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Polish. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Wyświetla grę we własnym oknie, przeskalowaną przez FSR, z generowaniem klatek i NR, bez zmiany żadnego pliku gry. Dla gier z anti-cheatem, do których nie wolno niczego wstrzykiwać.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} nie ma jeszcze na tym komputerze</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Około {0}, pobierane raz do folderu tej aplikacji i sprawdzane jak każdy inny plik. Nic nie jest instalowane w grze.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Pobierz NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} jest gotowe</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Aktualizuj do {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">Jest już NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive nie zostało jeszcze wydane dla OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Pojawi się z aktualizacją plików, bez ponownej instalacji czegokolwiek tutaj. Do tego czasu działa z własnego wydania.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Jego wydania</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Nie udało się pobrać NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Sesja skalowania</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Co przechwycić</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Okno na pierwszym planie po końcu odliczania</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Jedno z otwartych okien</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Gra z biblioteki</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nie ma czego wybrać</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Odczytaj otwarte okna ponownie</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Odliczanie (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Skaluj</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Uruchamianie · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Zatrzymaj</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Gotowe, kiedy zechcesz</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Przełącz się na grę</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Skalowanie</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Naciśnij „Skaluj”, a potem przełącz się na grę, zanim skończy się odliczanie.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive przejmie okno gry po końcu odliczania: przełącz się na nie teraz.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Zakończysz to przyciskiem „Zatrzymaj” albo skrótem {0} z poziomu gry.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Zatrzymano.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive zostało zamknięte. Przyczyna jest w NRLive.log w jego folderze.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive się nie uruchomiło: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive działa jako administrator, poza zasięgiem tej aplikacji: naciśnij {0}, aby je zatrzymać.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Uruchom jako administrator</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Gra uruchomiona jako administrator, jak większość gier z anti-cheatem, przyjmuje sterowanie przez NRLive tylko wtedy, gdy NRLive też działa jako administrator. Windows zapyta za każdym razem.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Skróty skalowania, zatrzymania i nakładki muszą się od siebie różnić.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">NRLive nie potrafi odczytać jednego ze skrótów. Przyjmuje modyfikatory i jeden klawisz, np. ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Klawisze przepuszczane muszą być klawiszami, które NRLive potrafi odczytać, rozdzielonymi przecinkami, np. home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Najpierw wybierz, co przechwycić.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows nie przyjął skrótu {0}: używa go inna aplikacja. Wybierz inną kombinację.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Zapisywane w pliku scaleconfig.ini NRLive, który edytuje też jego nakładka. Zmiana obowiązuje od następnego naciśnięcia „Skaluj”.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Skalowanie i klatki</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Renderowanie neuronowe</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Nakładka</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Więcej ustawień</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR potrzebuje modelu NVIDII w dlssnr-amd, a to NRLive przyszło bez niego. Plik DLSSNR-AMD-SETUP.txt w jego folderze wyjaśnia, jak wyodrębnić go z własnego pliku DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Nakładka NRLive (pasek i licznik)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Przechwytywanie</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Źródło przechwytywania</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (domyślnie)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, przycięte do okna</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Wektory ruchu</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (domyślnie)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Przepływ optyczny AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Skróty klawiszowe</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Kliknij pole i naciśnij kombinację. „Skaluj i zatrzymaj” działa wszędzie, także w grze, dopóki ta aplikacja jest otwarta.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Skaluj i zatrzymaj</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Wymuś zatrzymanie</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Nakładka</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Klawisze przepuszczane</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Klawisze, które trafiają do OptiScalera lub ReShade w grze zamiast do NRLive, rozdzielone przecinkami.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive tworzy Caliel; to wolne oprogramowanie na licencji GPL-3.0. Kod źródłowy:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — autor: Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Wyświetla przeskalowaną grę we własnym oknie, dla gier z anti-cheatem. Wolne oprogramowanie na licencji GPL-3.0; kod źródłowy jest na GitHubie.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">W tej grze wykryto {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Anti-cheat może zbanować konto za plik DLL dodany do gry, a obie metody instalacji dostępne tutaj taki plik dodają. NRLive skaluje okno gry z zewnątrz, z FSR, generowaniem klatek i NR, i nie zmienia niczego w jej folderze.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Użyj NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Ignoruj w tej grze</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.2">Brak</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Ostrość</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Generowanie klatek</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Limit klatek</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Ogranicz do</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Tryb limitera</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Płynny</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Niskie opóźnienie</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Runtime NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Własny NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Model</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Oryginalny</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Nowy, szybszy</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Styl</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutralny</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Naturalny</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Filmowy</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Rozdzielczość NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensywność</sys:String>
  <sys:String x:Key="Str.NrLiveSet.RenoDX.enabled">Wygląd RenoDX</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Przebiegi</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Struktura</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Kolor z NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Ton lokalny</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Maksymalny stosunek</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Struktura skóry</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Siła historii</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Sam wykrywa skórę</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilizator</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Licznik klatek</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Pozycja licznika</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Lewy górny róg</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Prawy górny róg</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Lewy dolny róg</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Prawy dolny róg</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu">Obciążenie i temperatura GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Klatki na sekundę</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Czas klatki</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Wykres czasu klatki</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Rozdzielczość</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Tło</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Obrys tekstu</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Rozmiar tekstu</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Krycie tła</sys:String>

</ResourceDictionary>
