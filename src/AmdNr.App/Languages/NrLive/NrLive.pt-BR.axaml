<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Brazilian Portuguese. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveComingSoon">NRLive em breve</sys:String>
  <sys:String x:Key="Str.NrLiveSubtitle">Roda o jogo numa janela própria, escalado com FSR, com geração de quadros e NR por cima, sem mexer em nenhum arquivo do jogo. Para jogos com anti-cheat, onde nada pode ser injetado.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">O NRLive {0} ainda não está neste PC</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Cerca de {0}, baixado uma vez para a pasta deste app e conferido como todos os outros arquivos. Nada é instalado no jogo.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Baixar o NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">O NRLive {0} está pronto</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Atualizar para {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">O NRLive {0} saiu.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">O NRLive ainda não foi publicado para o OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Ele chega numa atualização dos arquivos, sem precisar reinstalar nada aqui. Até lá, dá pra usar pela release dele.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Releases dele</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Não deu pra baixar o NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Sessão de escala</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">O que capturar</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">A janela em primeiro plano quando a contagem acabar</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Uma janela aberta agora</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Um jogo da biblioteca</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nada para escolher</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Ler as janelas abertas de novo</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Contagem (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Escalar</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Iniciando · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Parar</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Pronto quando você estiver</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Vá para o jogo</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Escalando</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Aperte Escalar e vá para o jogo antes de a contagem acabar.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">O NRLive pega a janela do jogo quando a contagem acabar: vá para ela agora.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Parar, ou {0} de dentro do jogo, encerra.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Parado.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">O NRLive fechou. O motivo está no NRLive.log, na pasta dele.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">O NRLive não iniciou: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">O NRLive roda como administrador, fora do alcance deste app: aperte {0} para pará-lo.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Executar como administrador</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Um jogo que roda como administrador, como a maioria dos que têm anti-cheat, só recebe comandos pelo NRLive se o NRLive também rodar como administrador. O Windows pergunta toda vez.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Os atalhos de escalar, parar e overlay precisam ser todos diferentes.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Um dos atalhos não é algo que o NRLive consiga ler. Ele aceita modificadores e uma tecla, como ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">As teclas repassadas precisam ser teclas que o NRLive consiga ler, separadas por vírgula, como home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Escolha antes o que capturar.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">O Windows não aceitou {0}: outro app já usa. Escolha outra combinação.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Fica salvo no scaleconfig.ini do NRLive, que o overlay dele também edita. Uma mudança vale a partir da próxima vez que Escalar for apertado.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Upscaling e quadros</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Neural rendering</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Mais opções</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">O NR precisa do modelo da NVIDIA em dlssnr-amd, e este NRLive veio sem ele. O DLSSNR-AMD-SETUP.txt na pasta dele explica como extraí-lo da sua própria DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Overlay do NRLive (barra e contador)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Captura</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Fonte da captura</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (padrão)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, recortado na janela</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Vetores de movimento</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (padrão)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Optical flow da AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Atalhos</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Clique numa caixa e aperte a combinação. Escalar e parar funciona em qualquer lugar, inclusive no jogo, enquanto este app estiver aberto.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Escalar e parar</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Forçar parada</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Teclas repassadas</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Teclas que vão para o OptiScaler ou o ReShade no jogo em vez de para o NRLive, separadas por vírgula.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">O NRLive é feito pelo Caliel e é software livre sob a GPL-3.0. O código-fonte:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — do Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Roda o jogo escalado numa janela própria, para jogos com anti-cheat. Software livre sob a GPL-3.0; o código está no GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">{0} encontrado neste jogo</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Um anti-cheat pode banir a conta por uma DLL colocada no jogo, e as duas formas de instalar daqui colocam uma. O NRLive escala a janela do jogo por fora, com FSR, geração de quadros e NR, e não muda nada na pasta dele.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Usar o NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Ignorar neste jogo</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Nitidez</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Geração de quadros</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Limite de quadros</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Limitar a</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Ritmo do limitador</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Suave</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Baixa latência</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Runtime do NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Automático</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">Ponte 0.0.6 do NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Modelo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Original</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Novo, mais rápido</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Estilo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutro</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Natural</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Cinematográfico</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Resolução em que o NR roda</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensidade</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Passadas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Estrutura</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Cor vinda do NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Tom local</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Proporção máxima</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Estrutura da pele</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Força do histórico</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Achar a pele sozinho</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Estabilizador</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Contador de quadros</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Posição do contador</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Superior esquerdo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Superior direito</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Inferior esquerdo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Inferior direito</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Quadros por segundo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Tempo de quadro</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Gráfico do tempo de quadro</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Resolução</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Fundo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Contorno do texto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Tamanho do texto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Opacidade do fundo</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">Nenhum (escala nativa)</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">O NR precisa do modelo da NVIDIA na pasta opennr, e ele não está lá. Baixe o NRLive de novo nesta página para recolocá-lo.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Modelo original (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Estilo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Padrão</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Natural</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">Cinematográfico</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">Intensidade</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">Passadas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">Tom local</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Estrutura local</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Estrutura da pele</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Máscara de personagem</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Pele separada da estrutura</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Cor vinda do NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Força do histórico</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Histórico temporal</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Grade de estilo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">Compilador de shaders ACO (a partir da próxima inicialização)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">Predefinição do HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Personalizado</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Mínimo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Compacto</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Padrão</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Completo</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Superior central</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Inferior central</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">Mínimas de 1% e 0,1%</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">Uso da GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">Temperatura da GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">Uso da CPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">Estado de FSR, NR e FG</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Tempo de GPU de cada passada</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">Tamanho do HUD</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Como os quadros e o movimento do jogo são lidos</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">Exibido na tela (clique para alternar)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">Prévia do HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Um quadro criado entre cada dois que o jogo desenha</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">Opções para</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">Globais</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (opções globais)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">Usar opções globais</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">Apaga as opções de {0} e volta para as globais.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">Um jogo da biblioteca ganha opções próprias na primeira vez que você muda uma delas enquanto ele aparece aqui. Quando a contagem acaba numa janela, valem as opções do jogo dela, se ele tiver. O que capturar, a contagem, o atalho de Escalar e rodar como administrador são iguais para todos os jogos.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">Opções: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">Opções: {0}. O upscaler, a captura e as teclas dele valem quando ele é escolhido como alvo.</sys:String>

</ResourceDictionary>
