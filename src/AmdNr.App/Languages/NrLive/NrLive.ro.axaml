<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Romanian. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Afișează un joc într-o fereastră proprie, scalat cu FSR, cu generare de cadre și NR peste el, fără să schimbe vreun fișier al jocului. Pentru jocurile cu anti-cheat, în care nu se poate injecta nimic.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} nu este încă pe acest PC</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Cam {0}, descărcat o singură dată în folderul acestei aplicații și verificat ca orice alt fișier. Nu se instalează nimic în vreun joc.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Descarcă NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} este pregătit</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Actualizează la {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">A apărut NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive nu este publicat încă pentru OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Vine cu o actualizare a fișierelor, fără să reinstalezi nimic aici. Până atunci rulează din propria lui versiune.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Versiunile lui</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">NRLive nu a putut fi descărcat: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Sesiune de scalare</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Ce se capturează</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Fereastra din față când se termină numărătoarea</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">O fereastră deschisă acum</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Un joc din bibliotecă</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nimic de ales</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Citește din nou ferestrele deschise</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Numărătoare (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Scalează</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Pornește · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Oprește</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Gata când vrei tu</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Treci la joc</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Se scalează</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Apasă „Scalează”, apoi treci la joc înainte să se termine numărătoarea.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive preia fereastra jocului când se termină numărătoarea: treci la ea acum.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Îl oprești cu „Oprește” sau cu {0} din joc.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Oprit.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive s-a închis. Motivul e în NRLive.log, în folderul lui.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive nu a pornit: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive rulează ca administrator, în afara controlului acestei aplicații: apasă {0} ca să-l oprești.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Rulează ca administrator</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Un joc care rulează ca administrator, cum fac majoritatea celor cu anti-cheat, primește input prin NRLive doar dacă și NRLive rulează ca administrator. Windows te întreabă de fiecare dată.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Tastele rapide pentru scalare, oprire și overlay trebuie să fie toate diferite.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">NRLive nu poate citi una dintre tastele rapide. Acceptă modificatori și o singură tastă, de exemplu ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Tastele transmise mai departe trebuie să fie taste pe care NRLive le poate citi, separate prin virgule, de exemplu home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Alege mai întâi ce se capturează.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows nu a acceptat {0}: o folosește altă aplicație. Alege altă combinație.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Se salvează în scaleconfig.ini al NRLive, pe care îl editează și overlay-ul lui. O modificare contează de la următoarea apăsare pe „Scalează”.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Upscaling și cadre</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Randare neurală</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Mai multe setări</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR are nevoie de modelul NVIDIA în dlssnr-amd, iar acest NRLive a venit fără el. DLSSNR-AMD-SETUP.txt din folderul lui explică cum îl extragi din propriul DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Overlay-ul NRLive (bară și contor)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Captură</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Sursa capturii</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (implicit)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, decupat la fereastră</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Vectori de mișcare</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (implicit)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Flux optic AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Taste rapide</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Dă clic pe o casetă și apasă combinația. „Scalează și oprește” merge oriunde, inclusiv în joc, cât timp aplicația e deschisă.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Scalează și oprește</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Oprire forțată</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Taste transmise</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Taste care ajung la OptiScaler sau ReShade din joc în loc de NRLive, separate prin virgule.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive este făcut de Caliel și este software liber sub GPL-3.0. Codul sursă:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive, de Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Afișează un joc scalat într-o fereastră proprie, pentru jocurile cu anti-cheat. Software liber sub GPL-3.0; codul sursă e pe GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">{0} găsit în acest joc</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Un anti-cheat poate bana contul pentru un DLL pus în joc, iar ambele moduri de instalare de aici pun unul. NRLive scalează fereastra jocului din exterior, cu FSR, generare de cadre și NR, și nu schimbă nimic în folderul lui.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Folosește NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Ignoră pentru acest joc</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveSet.Upscaler.mode.2">Niciunul</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Claritate</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Generare de cadre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Limită de cadre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Limitează la</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Mod limitator</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Fluid</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Latență mică</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Runtime NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Al NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Model</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Original</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Nou, mai rapid</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Stil</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutru</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Natural</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Cinematic</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Rezoluția la care rulează NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensitate</sys:String>
  <sys:String x:Key="Str.NrLiveSet.RenoDX.enabled">Aspect RenoDX</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Treceri</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Structură</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Culoare din NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Ton local</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Raport maxim</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Structura pielii</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Forța istoricului</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Găsește singur pielea</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Stabilizator</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Contor de cadre</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Poziția contorului</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Sus stânga</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Sus dreapta</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Jos stânga</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Jos dreapta</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu">Încărcarea și temperatura GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Cadre pe secundă</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Timp de cadru</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Grafic al timpului de cadru</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Rezoluție</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Fundal</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Contur text</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Mărime text</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Opacitatea fundalului</sys:String>

</ResourceDictionary>
