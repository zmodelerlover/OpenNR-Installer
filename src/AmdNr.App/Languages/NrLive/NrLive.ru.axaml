<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Russian. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveComingSoon">NRLive скоро появится</sys:String>
  <sys:String x:Key="Str.NrLiveSubtitle">Показывает игру в отдельном окне, масштабированную через FSR, с генерацией кадров и NR поверх, не меняя ни одного файла игры. Для игр с античитом, в которые ничего нельзя внедрять.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} ещё нет на этом ПК</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Около {0}. Загружается один раз в папку этого приложения и проверяется, как и все остальные файлы. В игру ничего не устанавливается.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Загрузить NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} готов</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Обновить до {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">Вышел NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive пока не опубликован для OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Он придёт с обновлением файлов, переустанавливать здесь ничего не нужно. А пока его можно запускать из его собственного релиза.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Его релизы</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Не удалось загрузить NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Сеанс масштабирования</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Что захватывать</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Окно, которое будет активным в конце отсчёта</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Окно, открытое сейчас</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Игра из библиотеки</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Выбирать не из чего</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Перечитать открытые окна</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Отсчёт (с)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Масштабировать</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Запуск · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Остановить</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Можно начинать</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Переключитесь на игру</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Масштабирование</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Нажмите «Масштабировать» и переключитесь на игру до конца отсчёта.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">В конце отсчёта NRLive захватит окно игры: переключитесь на него сейчас.</sys:String>
  <sys:String x:Key="Str.NrLiveTitleWaiting">Waiting for the game</sys:String>
  <sys:String x:Key="Str.NrLiveStatusWaiting">Waiting for {0} to start… NRLive starts once its window is up.</sys:String>
  <sys:String x:Key="Str.NrLiveWaitGaveUp">{0} did not start in 5 minutes. Start the game, then press Scale again.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Завершить можно кнопкой «Остановить» или сочетанием {0} прямо в игре.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Остановлено.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive закрылся. Причина — в NRLive.log в его папке.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive не запустился: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive запущен от имени администратора, и это приложение не может его остановить: нажмите {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Запускать от имени администратора</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Игра, запущенная от имени администратора (как большинство игр с античитом), принимает ввод через NRLive, только если NRLive тоже запущен от имени администратора. Windows спрашивает каждый раз.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Горячие клавиши масштабирования, остановки и оверлея должны различаться.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">NRLive не может прочитать одну из горячих клавиш. Нужны модификаторы и одна клавиша, например ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Сквозные клавиши должны быть такими, которые NRLive может прочитать, через запятую, например home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Сначала выберите, что захватывать.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows не дала занять {0}: это сочетание уже у другого приложения. Выберите другое.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Сохраняется в scaleconfig.ini NRLive, который меняет и его оверлей. Изменения применяются при следующем нажатии «Масштабировать».</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Апскейлинг и кадры</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Нейронный рендеринг</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Оверлей</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Другие настройки</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">Для NR нужна модель NVIDIA в dlssnr-amd, а эта сборка NRLive пришла без неё. В DLSSNR-AMD-SETUP.txt в его папке написано, как извлечь её из вашей собственной DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Оверлей NRLive (панель и счётчик)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Захват</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Источник захвата</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (по умолчанию)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI с обрезкой по окну</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Векторы движения</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (по умолчанию)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Оптический поток AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Горячие клавиши</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Щёлкните по полю и нажмите сочетание. «Масштабировать и остановить» работает везде, в том числе в игре, пока это приложение открыто.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Масштабировать и остановить</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Принудительная остановка</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Оверлей</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Сквозные клавиши</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Клавиши, которые уходят в игре к OptiScaler или ReShade, а не к NRLive; через запятую.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive создал Caliel; это свободное ПО под лицензией GPL-3.0. Исходный код:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — автор Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Показывает игру масштабированной в отдельном окне — для игр с античитом. Свободное ПО под GPL-3.0, исходный код на GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">В этой игре найден античит: {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Античит может забанить аккаунт за DLL, подложенную в игру, а оба способа установки здесь её туда кладут. NRLive масштабирует окно игры снаружи, с FSR, генерацией кадров и NR, и ничего не меняет в её папке.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Использовать NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Не показывать для этой игры</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Резкость</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Генерация кадров</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Ограничение кадров</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Ограничить до</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Режим ограничителя</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Плавный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Низкая задержка</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Рантайм NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Автоматически</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">Мост 0.0.6 из NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Модель</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Оригинальная</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Новая, быстрее</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Стиль</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Нейтральный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Естественный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Кинематографичный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Разрешение для NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Интенсивность</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Проходы</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Структура</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Цвет от NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Локальный тон</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Максимальное соотношение</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Структура кожи</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Сила истории</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Находить кожу автоматически</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Стабилизатор</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Счётчик кадров</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Положение счётчика</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Слева вверху</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Справа вверху</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Слева внизу</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Справа внизу</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Кадры в секунду</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Время кадра</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">График времени кадра</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Разрешение</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Фон</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Обводка текста</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Размер текста</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Непрозрачность фона</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Апскейлер</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">Нет (нативное масштабирование)</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">Для NR нужна модель NVIDIA в папке opennr, а её там нет. Скачайте NRLive с этой страницы ещё раз, чтобы вернуть её.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Оригинальная модель (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Стиль</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Стандартный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Естественный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">Кинематографичный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">Интенсивность</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">Проходы</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">Локальный тон</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Локальная структура</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Структура кожи</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Маска персонажей</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Кожа отдельно от структуры</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Цвет от NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Сила истории</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Временная история</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Цветокоррекция стиля</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">Компилятор шейдеров ACO (со следующего запуска)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">Пресет HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Свой</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Минимальный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Компактный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Стандартный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Полный</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Вверху по центру</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Внизу по центру</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1% и 0,1% low</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">Загрузка GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">Температура GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">Загрузка CPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">Состояние FSR, NR и FG</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Время GPU на каждый проход</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">Размер HUD</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Как считываются кадры и движение игры</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">На экране (нажмите, чтобы переключить)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">Предпросмотр HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Один кадр между каждыми двумя, которые рисует игра</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">Настройки для</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">Общие</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (общие настройки)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">Использовать общие настройки</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">Удаляет настройки для {0} и возвращает общие.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">Игра из библиотеки получает свои настройки, когда вы впервые меняете одну из них, пока она здесь показана. Если отсчёт заканчивается на окне, действуют настройки его игры, если они есть. Что захватывать, отсчёт, горячая клавиша масштабирования и запуск от имени администратора — общие для всех игр.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">Настройки: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">Настройки: {0}. Её апскейлер, захват и клавиши применятся, когда она выбрана целью.</sys:String>
  <!-- The look and encoding keys, grouped as in OptiScaler's menu -->
  <sys:String x:Key="Str.NrLiveGroup.composition">Композиция</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.composition.Hint">Как ответ модели возвращается в кадр.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look">Настроить вид NR</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.look.Hint">Правит изменение модели до композиции: насколько оно осветляет, затемняет и окрашивает.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding">Кодирование</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.encoding.Hint">Для кадров HDR. NRLive захватывает 8-bit SDR, а среда выполнения остаётся на пути SDR, поэтому сейчас эти настройки почти ничего не меняют. Кривые, в том числе AgX, находятся в разделе предобработки.</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess">Предобработка</sys:String>
  <sys:String x:Key="Str.NrLiveGroup.preprocess.Hint">Меняет картинку, которую видит сеть (экспозиция, кривая, контраст, насыщенность), и снимает это с её ответа, так что меняется то, как сеть правит кадр.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4">Смешанная сеть int4 (Оригинальная модель)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiInt4.Off">Сделана только из модели 310.8, поэтому не работает на новой модели Small. Ваш выбор сохранится до возврата к Оригинальной модели.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiNoiseEveryFrame">Менять шум без векторов движения</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoTransferStrength">Сохранённое изменение яркости</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoChromaClamp">Наибольшее изменение цвета</sys:String>
