  <sys:String x:Key="Str.NrLiveSet.FPS.gpu">โหลดและอุณหภูมิ GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">เฟรมต่อวินาที</sys:String>
