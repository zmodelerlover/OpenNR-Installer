  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">ความละเอียดที่ NR ทำงาน</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">ความเข้ม</sys:String>
  <sys:String x:Key="Str.NrLiveSet.RenoDX.enabled">โทนสี RenoDX</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">จำนวนรอบ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">โครงสร้าง</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">สีจาก NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">โทนเฉพาะจุด</sys:String>
