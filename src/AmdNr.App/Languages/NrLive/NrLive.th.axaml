  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">ความแรงของประวัติ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">ตรวจหาผิวอัตโนมัติ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">ตัวกันสั่น</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">ตัวนับเฟรม</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">ตำแหน่งตัวนับ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">บนซ้าย</sys:String>
