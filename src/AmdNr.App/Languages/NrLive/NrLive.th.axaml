<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Thai. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveComingSoon">NRLive เร็ว ๆ นี้</sys:String>
  <sys:String x:Key="Str.NrLiveSubtitle">เล่นเกมในหน้าต่างแยกของมันเอง ขยายภาพด้วย FSR พร้อมการสร้างเฟรมและ NR โดยไม่แก้ไขไฟล์ใดของเกมเลย สำหรับเกมที่มีระบบกันโกงซึ่งห้ามฉีดสิ่งใดเข้าไป</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">ยังไม่มี NRLive {0} บนพีซีนี้</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">ประมาณ {0} ดาวน์โหลดครั้งเดียวลงในโฟลเดอร์ของแอปนี้ และตรวจสอบเหมือนไฟล์อื่นทุกไฟล์ ไม่มีอะไรถูกติดตั้งลงในเกม</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">ดาวน์โหลด NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} พร้อมแล้ว</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">อัปเดตเป็น {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} ออกแล้ว</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive ยังไม่ได้เผยแพร่สำหรับ OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">จะมาพร้อมกับการอัปเดตไฟล์ โดยไม่ต้องติดตั้งอะไรใหม่ที่นี่ ระหว่างนี้ใช้งานจากรุ่นที่ NRLive เผยแพร่เองได้</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">รุ่นที่เผยแพร่</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">ดาวน์โหลด NRLive ไม่ได้: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">เซสชันการขยายภาพ</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">สิ่งที่จะจับภาพ</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">หน้าต่างที่อยู่ด้านหน้าเมื่อนับถอยหลังจบ</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">หน้าต่างที่เปิดอยู่ตอนนี้</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">เกมจากคลัง</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">ไม่มีอะไรให้เลือก</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">อ่านหน้าต่างที่เปิดอยู่อีกครั้ง</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">นับถอยหลัง (วินาที)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">ขยายภาพ</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">กำลังเริ่ม · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">หยุด</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">พร้อมเมื่อคุณพร้อม</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">สลับไปที่เกม</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">กำลังขยายภาพ</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">กด «ขยายภาพ» แล้วสลับไปที่เกมก่อนนับถอยหลังจบ</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive จะจับหน้าต่างเกมเมื่อนับถอยหลังจบ สลับไปที่เกมตอนนี้เลย</sys:String>
  <sys:String x:Key="Str.NrLiveTitleWaiting">Waiting for the game</sys:String>
  <sys:String x:Key="Str.NrLiveStatusWaiting">Waiting for {0} to start… NRLive starts once its window is up.</sys:String>
  <sys:String x:Key="Str.NrLiveWaitGaveUp">{0} did not start in 5 minutes. Start the game, then press Scale again.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">กด «หยุด» หรือกด {0} ในเกมเพื่อจบ</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">หยุดแล้ว</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive ปิดไปแล้ว สาเหตุอยู่ใน NRLive.log ในโฟลเดอร์ของมัน</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive เริ่มทำงานไม่ได้: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive ทำงานในฐานะผู้ดูแลระบบ แอปนี้จึงควบคุมไม่ได้ กด {0} เพื่อหยุด</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">เรียกใช้ในฐานะผู้ดูแลระบบ</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">เกมที่ทำงานในฐานะผู้ดูแลระบบ ซึ่งเกมที่มีระบบกันโกงส่วนใหญ่เป็นแบบนั้น จะรับอินพุตผ่าน NRLive ได้ก็ต่อเมื่อ NRLive ทำงานในฐานะผู้ดูแลระบบด้วย Windows จะถามทุกครั้ง</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">ปุ่มลัดของขยายภาพ หยุด และโอเวอร์เลย์ต้องไม่ซ้ำกัน</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">มีปุ่มลัดที่ NRLive อ่านไม่ได้ ต้องเป็นปุ่มปรับแต่งกับปุ่มเดียว เช่น ctrl+alt+s</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">ปุ่มส่งผ่านต้องเป็นปุ่มที่ NRLive อ่านได้ คั่นด้วยจุลภาค เช่น home,insert</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">เลือกสิ่งที่จะจับภาพก่อน</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows ใช้ {0} ไม่ได้ เพราะแอปอื่นใช้อยู่ เลือกชุดปุ่มอื่น</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">บันทึกไว้ใน scaleconfig.ini ของ NRLive ซึ่งโอเวอร์เลย์ของมันก็แก้ไขด้วย การเปลี่ยนแปลงจะมีผลตั้งแต่ครั้งถัดไปที่กด «ขยายภาพ»</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">การขยายภาพและเฟรม</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">การเรนเดอร์แบบนิวรัล</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">โอเวอร์เลย์</sys:String>
  <sys:String x:Key="Str.NrLiveMore">การตั้งค่าเพิ่มเติม</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR ต้องใช้โมเดลของ NVIDIA ใน dlssnr-amd และ NRLive ชุดนี้ไม่ได้มีมาให้ DLSSNR-AMD-SETUP.txt ในโฟลเดอร์ของมันบอกวิธีดึงออกมาจาก DLL ของคุณเอง</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">โอเวอร์เลย์ของ NRLive (แถบและตัวนับ)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">การจับภาพ</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">แหล่งจับภาพ</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (ค่าเริ่มต้น)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI ครอปตามหน้าต่าง</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">เวกเตอร์การเคลื่อนไหว</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (ค่าเริ่มต้น)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD optical flow</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">ปุ่มลัด</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">คลิกช่องแล้วกดชุดปุ่ม ปุ่ม «ขยายภาพและหยุด» ใช้ได้ทุกที่รวมถึงในเกม ตราบที่แอปนี้เปิดอยู่</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">ขยายภาพและหยุด</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">บังคับหยุด</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">โอเวอร์เลย์</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">ปุ่มส่งผ่าน</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">ปุ่มที่ส่งต่อให้ OptiScaler หรือ ReShade ในเกมแทน NRLive คั่นด้วยจุลภาค</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive สร้างโดย Caliel เป็นซอฟต์แวร์เสรีภายใต้ GPL-3.0 ซอร์สโค้ด:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — โดย Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">เล่นเกมแบบขยายภาพในหน้าต่างแยกของมันเอง สำหรับเกมที่มีระบบกันโกง เป็นซอฟต์แวร์เสรีภายใต้ GPL-3.0 ซอร์สโค้ดอยู่บน GitHub</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">พบ {0} ในเกมนี้</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">ระบบกันโกงอาจแบนบัญชีเพราะมี DLL ที่ใส่ไว้ในเกม และวิธีติดตั้งทั้งสองแบบที่นี่ต่างก็ใส่ DLL ลงไป NRLive ขยายภาพหน้าต่างเกมจากภายนอกด้วย FSR การสร้างเฟรม และ NR โดยไม่เปลี่ยนแปลงอะไรในโฟลเดอร์ของเกม</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">ใช้ NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">ละเว้นสำหรับเกมนี้</sys:String>

