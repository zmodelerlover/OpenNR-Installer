  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">ของ NRLive เอง</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">โมเดล</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">ต้นฉบับ</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">ใหม่ เร็วกว่า</sys:String>
