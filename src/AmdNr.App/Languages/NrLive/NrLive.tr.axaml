  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU yükü</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU sıcaklığı</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU yükü</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR, NR ve FG durumu</sys:String>
