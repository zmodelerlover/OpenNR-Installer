  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">NR'den gelen renk</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Geçmiş gücü</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Zamansal geçmiş</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Stil renk düzenlemesi</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">ACO gölgelendirici derleyicisi (bir sonraki başlatmadan itibaren)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">HUD ön ayarı</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Özel</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">En az</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Kompakt</sys:String>
