  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">NR, opennr klasöründe NVIDIA'nın modeline ihtiyaç duyar ve model orada değil. Geri koymak için NRLive'ı bu sayfadan yeniden indirin.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Orijinal model (310.8)</sys:String>
