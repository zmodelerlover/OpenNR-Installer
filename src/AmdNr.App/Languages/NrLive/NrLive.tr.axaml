<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Turkish. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Oyunu kendi penceresinde, FSR ile ölçeklenmiş, üstüne kare oluşturma ve NR eklenmiş olarak gösterir; oyunun hiçbir dosyasını değiştirmez. İçine hiçbir şey enjekte edilemeyen, hile korumalı oyunlar için.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} henüz bu bilgisayarda yok</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Yaklaşık {0}. Bu uygulamanın klasörüne bir kez indirilir ve diğer tüm dosyalar gibi doğrulanır. Oyuna hiçbir şey kurulmaz.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">NRLive'ı indir</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} hazır</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">{0} sürümüne güncelle</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} çıktı.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive henüz OpenNR için yayımlanmadı</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Bir dosya güncellemesiyle gelecek; burada yeniden kurulacak bir şey yok. O zamana kadar kendi sürümünden çalıştırabilirsiniz.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Sürümleri</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">NRLive indirilemedi: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Ölçekleme oturumu</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Ne yakalanacak</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Geri sayım bittiğinde öndeki pencere</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Şu an açık bir pencere</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Kitaplıktan bir oyun</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Seçilecek bir şey yok</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Açık pencereleri yeniden oku</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Geri sayım (sn)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Ölçekle</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Başlıyor · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Durdur</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Hazır olduğunuzda</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Oyuna geçin</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Ölçekleniyor</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Ölçekle'ye basın, sonra geri sayım bitmeden oyuna geçin.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">Geri sayım bitince NRLive oyunun penceresini alır: şimdi ona geçin.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Durdur'a basarak ya da oyunun içinden {0} ile sonlandırabilirsiniz.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Durduruldu.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive kapandı. Nedeni, klasöründeki NRLive.log dosyasında.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive başlamadı: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive yönetici olarak çalışıyor ve bu uygulama ona ulaşamıyor: durdurmak için {0} tuşlarına basın.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Yönetici olarak çalıştır</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Yönetici olarak çalışan bir oyun (hile korumalı oyunların çoğu böyledir), NRLive üzerinden girdiyi ancak NRLive da yönetici olarak çalışıyorsa alır. Windows her seferinde sorar.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Ölçekleme, durdurma ve katman kısayolları birbirinden farklı olmalı.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">Kısayollardan biri NRLive'ın okuyabileceği türden değil. Değiştirici tuşlar ve tek bir tuş alır, örneğin ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Geçiş tuşları NRLive'ın okuyabileceği tuşlar olmalı ve virgülle ayrılmalı, örneğin home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Önce ne yakalanacağını seçin.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows {0} kısayolunu vermedi: başka bir uygulama kullanıyor. Başka bir kombinasyon seçin.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">NRLive'ın scaleconfig.ini dosyasına kaydedilir; NRLive'ın katmanı da bu dosyayı düzenler. Değişiklikler, Ölçekle'ye bir sonraki basışta geçerli olur.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Ölçekleme ve kareler</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Nöral işleme</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Katman</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Diğer ayarlar</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR, dlssnr-amd içinde NVIDIA'nın modeline ihtiyaç duyar ve bu NRLive onsuz geldi. Kendi DLL dosyanızdan nasıl çıkaracağınız, klasöründeki DLSSNR-AMD-SETUP.txt dosyasında anlatılıyor.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">NRLive katmanı (çubuk ve sayaç)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Yakalama</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Yakalama kaynağı</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (varsayılan)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, pencereye göre kırpılmış</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Hareket vektörleri</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (varsayılan)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD optik akış</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Kısayol tuşları</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Bir kutuya tıklayın ve kombinasyona basın. Ölçekle ve durdur, bu uygulama açık olduğu sürece oyun dahil her yerde çalışır.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Ölçekle ve durdur</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Zorla durdur</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Katman</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Geçiş tuşları</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">NRLive yerine oyundaki OptiScaler'a veya ReShade'e iletilen tuşlar, virgülle ayrılmış.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive, Caliel tarafından yapılmıştır ve GPL-3.0 lisanslı özgür yazılımdır. Kaynak kodu:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Hile korumalı oyunlar için oyunu kendi penceresinde ölçeklenmiş olarak gösterir. GPL-3.0 lisanslı özgür yazılım; kaynak kodu GitHub'da.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">Bu oyunda hile koruması bulundu: {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Hile koruması, oyuna konan bir DLL yüzünden hesabı yasaklayabilir ve buradaki iki kurulum yolu da oyuna bir DLL koyar. NRLive oyunun penceresini dışarıdan, FSR, kare oluşturma ve NR ile ölçekler ve oyunun klasöründe hiçbir şeyi değiştirmez.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">NRLive kullan</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Bu oyun için yok say</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Keskinlik</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Kare oluşturma</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Kare sınırı</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Sınır</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Sınırlayıcı zamanlaması</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Akıcı</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Düşük gecikme</sys:String>
