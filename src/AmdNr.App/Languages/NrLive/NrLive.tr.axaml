  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Cildi kendisi bulsun</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Sabitleyici</sys:String>
