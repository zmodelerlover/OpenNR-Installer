  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Yerel yapı</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Cilt yapısı</sys:String>
