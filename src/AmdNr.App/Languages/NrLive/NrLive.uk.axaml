<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Ukrainian. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">Показує гру в окремому вікні, масштабовану через FSR, з генерацією кадрів і NR поверх, не змінюючи жодного файлу гри. Для ігор з античитом, у які нічого не можна впроваджувати.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} ще немає на цьому ПК</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">Близько {0}. Завантажується один раз у папку цієї програми й перевіряється, як і всі інші файли. У гру нічого не встановлюється.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Завантажити NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} готовий</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Оновити до {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">Вийшов NRLive {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive ще не опубліковано для OpenNR</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">Він прийде з оновленням файлів, і тут нічого не доведеться перевстановлювати. А поки його можна запускати з його власного випуску.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Його випуски</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">Не вдалося завантажити NRLive: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Сеанс масштабування</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">Що захоплювати</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">Вікно, активне наприкінці відліку</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">Вікно, відкрите зараз</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">Гра з бібліотеки</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Немає з чого вибрати</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Перечитати відкриті вікна</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Відлік (с)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Масштабувати</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Запуск · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Зупинити</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Можна починати</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Перейдіть у гру</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Масштабування</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Натисніть «Масштабувати» й перейдіть у гру до кінця відліку.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">Наприкінці відліку NRLive захопить вікно гри: перейдіть у нього зараз.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Завершити можна кнопкою «Зупинити» або сполученням {0} просто в грі.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Зупинено.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive закрився. Причина — у NRLive.log у його папці.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive не запустився: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive працює від імені адміністратора, і ця програма не може його зупинити: натисніть {0}.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Запускати від імені адміністратора</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">Гра, запущена від імені адміністратора (як більшість ігор з античитом), приймає введення через NRLive, лише якщо NRLive теж запущено від імені адміністратора. Windows питає щоразу.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">Гарячі клавіші масштабування, зупинки й оверлею мають бути різними.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">NRLive не може прочитати одну з гарячих клавіш. Потрібні модифікатори й одна клавіша, наприклад ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">Наскрізні клавіші мають бути такими, що їх може прочитати NRLive, через кому, наприклад home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Спершу виберіть, що захоплювати.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows не дала зайняти {0}: це сполучення вже має інша програма. Виберіть інше.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Зберігається в scaleconfig.ini NRLive, який змінює і його оверлей. Зміни діють з наступного натискання «Масштабувати».</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Апскейлінг і кадри</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Нейронний рендеринг</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Оверлей</sys:String>
  <sys:String x:Key="Str.NrLiveMore">Інші налаштування</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">Для NR потрібна модель NVIDIA в dlssnr-amd, а ця збірка NRLive прийшла без неї. У DLSSNR-AMD-SETUP.txt у його папці написано, як видобути її з вашої власної DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">Оверлей NRLive (панель і лічильник)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Захоплення</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Джерело захоплення</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (за замовчуванням)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI з обрізанням по вікну</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Вектори руху</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (за замовчуванням)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">Оптичний потік AMD</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Гарячі клавіші</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Клацніть поле й натисніть сполучення. «Масштабувати й зупинити» працює всюди, зокрема в грі, поки ця програма відкрита.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Масштабувати й зупинити</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Примусова зупинка</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Оверлей</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Наскрізні клавіші</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Клавіші, які в грі йдуть до OptiScaler або ReShade, а не до NRLive; через кому.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive створив Caliel; це вільне ПЗ за ліцензією GPL-3.0. Вихідний код:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — автор Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Показує гру масштабованою в окремому вікні — для ігор з античитом. Вільне ПЗ за GPL-3.0, вихідний код на GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">У цій грі знайдено античит: {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">Античит може забанити акаунт за DLL, підкладену в гру, а обидва способи встановлення тут її туди кладуть. NRLive масштабує вікно гри ззовні, з FSR, генерацією кадрів і NR, і нічого не змінює в її папці.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Використати NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Не показувати для цієї гри</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Різкість</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Генерація кадрів</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Обмеження кадрів</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Обмежити до</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Режим обмежувача</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Плавний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Низька затримка</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">Рантайм NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Автоматично</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">Міст 0.0.6 з NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Модель</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Оригінальна</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">Нова, швидша</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Стиль</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Нейтральний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Природний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Кінематографічний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Роздільність для NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Інтенсивність</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Проходи</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Структура</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Колір від NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Локальний тон</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Максимальне співвідношення</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Структура шкіри</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">Сила історії</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Знаходити шкіру автоматично</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Стабілізатор</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Лічильник кадрів</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Розташування лічильника</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Ліворуч угорі</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Праворуч угорі</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Ліворуч унизу</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Праворуч унизу</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Кадри за секунду</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Час кадру</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Графік часу кадру</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Роздільність</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Тло</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Обведення тексту</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Розмір тексту</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Непрозорість тла</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Апскейлер</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">Немає (нативне масштабування)</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">Для NR потрібна модель NVIDIA в папці opennr, а її там немає. Завантажте NRLive з цієї сторінки ще раз, щоб повернути її.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Оригінальна модель (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Стиль</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Стандартний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Природний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">Кінематографічний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">Інтенсивність</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">Проходи</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">Локальний тон</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Локальна структура</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Структура шкіри</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Маска персонажів</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Шкіра окремо від структури</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Колір від NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">Сила історії</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Часова історія</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Кольорокорекція стилю</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">Компілятор шейдерів ACO (з наступного запуску)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">Пресет HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Власний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Мінімальний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Компактний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Стандартний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Повний</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Угорі по центру</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Унизу по центру</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1% і 0,1% low</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">Навантаження GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">Температура GPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">Навантаження CPU</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">Стан FSR, NR і FG</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">Час GPU на кожен прохід</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">Розмір HUD</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">Як зчитуються кадри й рух гри</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">На екрані (натисніть, щоб перемкнути)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">Попередній перегляд HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">Один кадр між кожними двома, які малює гра</sys:String>

</ResourceDictionary>
