<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Pirate English. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveComingSoon">NRLive be sailin' in soon</sys:String>
  <sys:String x:Key="Str.NrLiveSubtitle">Sails a game in a window o' its own, scaled with FSR, with frame generation an' NR on top, without touchin' a single file o' the game. For games with anti-cheat, where nothin' may be smuggled aboard.</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">NRLive {0} ain't on this PC yet</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">About {0}, hauled aboard once into this app's hold an' checked like every other file. Nothin' be hoisted into a game.</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">Haul NRLive aboard</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} be ready</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">Update to {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} has set sail.</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive ain't flyin' OpenNR's colours yet</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">It comes aboard with a cargo update, with nothin' to hoist again here. Till then, it sails from its own release.</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">Its releases</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">NRLive couldn't be hauled aboard: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">Scalin' voyage</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">What to capture</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">The window up front when the countdown runs out</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">A window open now</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">A game from the list</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">Nothin' to pick</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">Spy the open windows again</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">Countdown (s)</sys:String>
  <sys:String x:Key="Str.NrLiveScale">Scale</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">Raisin' anchor · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">Belay</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">Ready when ye be</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">Jump to the game</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">Scalin'</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">Press Scale, then jump to the game afore the countdown runs out.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">NRLive boards the game's window when the countdown runs out: jump to it now.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">Belay, or {0} from inside the game, ends it.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">Belayed.</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive went down. Why be in NRLive.log, in its hold.</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive wouldn't set sail: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive sails as administrator, out o' this app's reach: press {0} to belay it.</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">Sail as administrator</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">A game that sails as administrator, as most with anti-cheat do, only takes yer input through NRLive when NRLive sails as administrator too. Windows asks every time.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">The scale, belay an' overlay hotkeys must all be different.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">A hotkey ain't one NRLive can read. It takes modifiers an' one key, like ctrl+alt+s.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">The passthrough keys have to be keys NRLive can read, split by commas, like home,insert.</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">Pick what to capture first.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows wouldn't give up {0}: another app claimed it. Pick another combination.</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">Stowed in NRLive's scaleconfig.ini, which its overlay scribbles in too. A change counts from the next time Scale be pressed.</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">Upscalin' an' frames</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">Neural renderin'</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveMore">More settings</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR needs NVIDIA's model in dlssnr-amd, an' this NRLive came without it. DLSSNR-AMD-SETUP.txt in its hold says how to pry it out o' yer own DLL.</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">NRLive's overlay (bar an' counter)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">Capture</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">Capture source</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture (default)</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI, cut down to the window</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">Motion vectors</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV (default)</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD optical flow</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">Hotkeys</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">Click a box an' press the combination. Scale an' belay works anywhere, the game included, while this app be open.</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">Scale an' belay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">Belay by force</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">Overlay</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">Passthrough keys</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">Keys passed on to OptiScaler or ReShade in the game instead o' to NRLive, split by commas.</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive be built by Caliel an' be free software under the GPL-3.0. Its source code:</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive — by Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">Sails a game scaled in a window o' its own, for games with anti-cheat. Free software under the GPL-3.0; its source be on GitHub.</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">{0} spotted in this game</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">An anti-cheat can make the account walk the plank for a DLL put in the game, an' both headings here put one in. NRLive scales the game's window from outside, with FSR, frame generation an' NR, an' touches nothin' in its hold.</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">Use NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">Pay it no mind for this game</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">Sharpness</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">Frame generation</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">Frame limit</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">Limit to</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">Limiter timin'</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">Calm seas</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">Low latency</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">NR engine</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">Automatic</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">NRLive's 0.0.6 gangplank</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">Model</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">Original</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">New, faster</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">Style</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">Neutral</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">Natural</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">Cinematic</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">Resolution NR sails at</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">Intensity</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">Passes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">Structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">Colour from NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">Local tone</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">Maximum ratio</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">Skin structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">History strength</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">Spot skin by itself</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">Steady hand</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">Frame counter</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">Counter position</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">Top port</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">Top starboard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">Bottom port</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">Bottom starboard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">Frames per second</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">Frame time</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">Frame time chart</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">Resolution</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">Background</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">Text outline</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">Text size</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">Background opacity</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">Upscaler</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">None (native scalin')</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">NR needs NVIDIA's model in the opennr hold, an' it ain't there. Fetch NRLive again from this page to stow it back aboard.</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">Original model (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">Style</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">Standard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">Natural</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">Cinematic</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">Intensity</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">Passes</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">Local tone</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">Local structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">Skin structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">Crew mask</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">Skin kept apart from structure</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">Colour from NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">History strength</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">Temporal history</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">Style grade</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">ACO shader compiler (from the next launch)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">HUD rig</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">Custom</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">Bare bones</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">Compact</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">Standard</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">Full sail</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">Top amidships</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">Bottom amidships</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1% an' 0.1% lows</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU load</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU temperature</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU load</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR, NR an' FG state</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">GPU time o' each pass</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">HUD size</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureHint">How the game&apos;s frames an&apos; motion be read</sys:String>
  <sys:String x:Key="Str.NrLiveHudItems">Shown on yer screen (click to hoist or strike)</sys:String>
  <sys:String x:Key="Str.NrLiveHudPreview">Spyglass on the HUD</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled.Hint">One frame forged betwixt every two the game draws</sys:String>
  <sys:String x:Key="Str.NrLiveProfileFor">Settings fer</sys:String>
  <sys:String x:Key="Str.NrLiveProfileGlobal">The whole fleet</sys:String>
  <sys:String x:Key="Str.NrLiveProfileShared">{0} (fleet settings)</sys:String>
  <sys:String x:Key="Str.NrLiveProfileReset">Use the fleet's settings</sys:String>
  <sys:String x:Key="Str.NrLiveProfileResetHint">Throws {0}'s own settings overboard an' goes back to the fleet's.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileHint">A game from the list gets settings o' its own the first time ye change one while it be shown here. When the countdown ends on a window, its game's settings be used if it has any. What to capture, the countdown, the scale hotkey an' sailin' as administrator be the same fer every game.</sys:String>
  <sys:String x:Key="Str.NrLiveProfileInUse">Settings: {0}</sys:String>
  <sys:String x:Key="Str.NrLiveProfileLaunchKept">Settings: {0}. Its upscaler, capture an' keys only count once it be picked as the target.</sys:String>

</ResourceDictionary>
