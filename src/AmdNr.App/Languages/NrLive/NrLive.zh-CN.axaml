<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Simplified Chinese. The same keys as NrLive.en.axaml, in its order. -->

  <!-- The page -->
  <sys:String x:Key="Str.NrLiveSubtitle">在单独的窗口中运行游戏，用 FSR 放大，并叠加帧生成和 NR，不改动游戏的任何文件。适用于带反作弊、不能注入任何东西的游戏。</sys:String>
  <sys:String x:Key="Str.NrLiveNotDownloaded">此电脑上还没有 NRLive {0}</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadHint">约 {0}，只需下载一次，放在本应用的文件夹中，并像其他文件一样校验。不会往游戏里安装任何东西。</sys:String>
  <sys:String x:Key="Str.NrLiveDownload">下载 NRLive</sys:String>
  <sys:String x:Key="Str.NrLiveReady">NRLive {0} 已就绪</sys:String>
  <sys:String x:Key="Str.NrLiveUpdate">更新到 {0}</sys:String>
  <sys:String x:Key="Str.NrLiveUpdateHint">NRLive {0} 已发布。</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailable">NRLive 尚未为 OpenNR 发布</sys:String>
  <sys:String x:Key="Str.NrLiveUnavailableHint">它会随文件更新一起到来，这里无需重新安装。在此之前，可以从它自己的发布版运行。</sys:String>
  <sys:String x:Key="Str.NrLiveOpenRelease">它的发布版</sys:String>
  <sys:String x:Key="Str.NrLiveDownloadFailed">无法下载 NRLive：{0}</sys:String>
  <sys:String x:Key="Str.NrLiveSessionSection">缩放会话</sys:String>
  <sys:String x:Key="Str.NrLiveTarget">捕获对象</sys:String>
  <sys:String x:Key="Str.NrLiveTargetPicker">倒计时结束时位于最前面的窗口</sys:String>
  <sys:String x:Key="Str.NrLiveTargetWindow">当前打开的窗口</sys:String>
  <sys:String x:Key="Str.NrLiveTargetGame">游戏库中的游戏</sys:String>
  <sys:String x:Key="Str.NrLiveNothingToPick">没有可选的内容</sys:String>
  <sys:String x:Key="Str.NrLiveRefresh">重新读取打开的窗口</sys:String>
  <sys:String x:Key="Str.NrLiveCountdown">倒计时（秒）</sys:String>
  <sys:String x:Key="Str.NrLiveScale">缩放</sys:String>
  <sys:String x:Key="Str.NrLiveStarting">正在启动 · {0}</sys:String>
  <sys:String x:Key="Str.NrLiveStop">停止</sys:String>
  <sys:String x:Key="Str.NrLiveTitleReady">随时可以开始</sys:String>
  <sys:String x:Key="Str.NrLiveTitleStarting">切换到游戏</sys:String>
  <sys:String x:Key="Str.NrLiveTitleRunning">正在缩放</sys:String>
  <sys:String x:Key="Str.NrLiveStatusReady">按“缩放”，然后在倒计时结束前切换到游戏。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStarting">倒计时结束时 NRLive 会接管游戏窗口：现在切换过去。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusRunning">按“停止”，或在游戏内按 {0} 即可结束。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusStopped">已停止。</sys:String>
  <sys:String x:Key="Str.NrLiveStatusExited">NRLive 已关闭。原因记录在它文件夹中的 NRLive.log 里。</sys:String>
  <sys:String x:Key="Str.NrLiveStartFailed">NRLive 未能启动：{0}</sys:String>
  <sys:String x:Key="Str.NrLiveStopFailed">NRLive 以管理员身份运行，本应用无法控制它：请按 {0} 停止。</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdmin">以管理员身份运行</sys:String>
  <sys:String x:Key="Str.NrLiveRunAsAdminHint">以管理员身份运行的游戏（大多数带反作弊的游戏都是如此），只有在 NRLive 也以管理员身份运行时，才能通过 NRLive 接收输入。Windows 每次都会询问。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemConflict">缩放、停止和叠加界面的快捷键必须各不相同。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemHotkey">有一个快捷键 NRLive 无法识别。它需要修饰键加一个按键，例如 ctrl+alt+s。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemBypass">直通按键必须是 NRLive 能识别的按键，用逗号分隔，例如 home,insert。</sys:String>
  <sys:String x:Key="Str.NrLiveProblemTarget">请先选择要捕获的对象。</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyTaken">Windows 无法注册 {0}：已被其他应用占用。请换一个组合。</sys:String>
  <sys:String x:Key="Str.NrLiveSettingsHint">保存在 NRLive 的 scaleconfig.ini 中，它的叠加界面也会修改这个文件。更改从下次按“缩放”时生效。</sys:String>
  <sys:String x:Key="Str.NrLivePictureSection">放大与帧</sys:String>
  <sys:String x:Key="Str.NrLiveNrSection">神经渲染</sys:String>
  <sys:String x:Key="Str.NrLiveOverlaySection">叠加界面</sys:String>
  <sys:String x:Key="Str.NrLiveMore">更多设置</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissing">NR 需要 dlssnr-amd 中的 NVIDIA 模型，而这个 NRLive 没有附带。它文件夹中的 DLSSNR-AMD-SETUP.txt 说明了如何从你自己的 DLL 中提取。</sys:String>
  <sys:String x:Key="Str.NrLiveOverlay">NRLive 的叠加界面（工具栏和计数器）</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSection">捕获</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureSource">捕获来源</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureWgc">Windows Graphics Capture（默认）</sys:String>
  <sys:String x:Key="Str.NrLiveCaptureDxgi">DXGI，裁剪到窗口</sys:String>
  <sys:String x:Key="Str.NrLiveMotion">运动矢量</sys:String>
  <sys:String x:Key="Str.NrLiveMotionFast">FastMV（默认）</sys:String>
  <sys:String x:Key="Str.NrLiveMotionAmdof">AMD 光流</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeysSection">快捷键</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyHint">点击输入框，然后按下组合键。只要本应用开着，“缩放和停止”在任何地方都有效，包括游戏内。</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyScale">缩放和停止</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyStop">强制停止</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyOverlay">叠加界面</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypass">直通按键</sys:String>
  <sys:String x:Key="Str.NrLiveHotkeyBypassHint">这些按键会传给游戏中的 OptiScaler 或 ReShade，而不是 NRLive，用逗号分隔。</sys:String>
  <sys:String x:Key="Str.NrLiveCredit">NRLive 由 Caliel 制作，是基于 GPL-3.0 的自由软件。源代码：</sys:String>
  <sys:String x:Key="Str.CreditNrLiveTitle">NRLive，作者 Caliel</sys:String>
  <sys:String x:Key="Str.CreditNrLiveBody">在单独的窗口中缩放运行游戏，适用于带反作弊的游戏。基于 GPL-3.0 的自由软件，源代码在 GitHub 上。</sys:String>

  <!-- The anti-cheat warning on a game's sheet -->
  <sys:String x:Key="Str.AntiCheatTitle">在此游戏中发现了 {0}</sys:String>
  <sys:String x:Key="Str.AntiCheatBody">反作弊可能会因为放进游戏的 DLL 而封禁账号，而这里的两种安装方式都会放入 DLL。NRLive 从外部缩放游戏窗口，带有 FSR、帧生成和 NR，不改动游戏文件夹中的任何东西。</sys:String>
  <sys:String x:Key="Str.AntiCheatUse">使用 NRLive</sys:String>
  <sys:String x:Key="Str.AntiCheatIgnore">此游戏不再提示</sys:String>

  <!-- NRLive's settings, one per key of scaleconfig.ini (NrLiveConfig.Settings), and the entries of each menu -->
  <sys:String x:Key="Str.NrLiveSet.FSR.sharpness">锐度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameGeneration.enabled">帧生成</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.enabled">帧率限制</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.fps">限制为</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method">限帧方式</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.0">平滑</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FrameLimiter.method.1">低延迟</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.enabled">NR</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime">NR 运行时</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.0">自动</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.1">OpenNR (mochizuki)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.runtime.2">NRLive 的 0.0.6 桥接</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model">模型</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.0">原版</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.model.1">新版，更快</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style">风格</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.0">中性</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.1">自然</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.style.2">电影感</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.scale">NR 运行分辨率</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.intensity">强度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.passes">处理次数</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.structure">结构</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.color_strength">NR 色彩</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.local_tone">局部色调</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.max_ratio">最大比例</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.skin_structure">皮肤结构</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.history_strength">历史强度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.automatic_skin_mask">自动识别皮肤</sys:String>
  <sys:String x:Key="Str.NrLiveSet.DLSSNR.stabilizer">稳定器</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.enabled">帧数计数器</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position">计数器位置</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.0">左上</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.1">右上</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.2">左下</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.3">右下</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.fps">每秒帧数</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frametime">帧时间</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.frame_timing">帧时间图表</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.resolution">分辨率</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background">背景</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.text_outline">文字描边</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.font_size">文字大小</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.background_alpha">背景不透明度</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler">放大器</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.0">FSR 4</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.1">FSR 3.1</sys:String>
  <sys:String x:Key="Str.NrLiveUpscaler.2">无（原生缩放）</sys:String>
  <sys:String x:Key="Str.NrLiveModelMissingOpenNr">NR 需要 opennr 文件夹中的 NVIDIA 模型，但它不在那里。从本页面重新下载 NRLive 即可放回。</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiOriginalModel">原版模型 (310.8)</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle">风格</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.0">标准</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.1">自然</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoStyle.2">电影感</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoIntensity">强度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoPasses">处理次数</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalTone">局部色调</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoLocalStructure">局部结构</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinStructure">皮肤结构</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoAutoMask">角色遮罩</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoSkinIndependent">皮肤与结构分开处理</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiRenoColorStrength">NR 色彩</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiHistoryStrength">历史强度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiTemporal">时间历史</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiStyleGrade">风格调色</sys:String>
  <sys:String x:Key="Str.NrLiveSet.OpenNR.MochizukiAco">ACO 着色器编译器（下次启动起生效）</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset">HUD 预设</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.0">自定义</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.1">极简</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.2">紧凑</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.3">标准</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.preset.4">完整</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.4">顶部居中</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.position.5">底部居中</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.lows">1% 和 0.1% 低帧</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_load">GPU 占用</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_temp">GPU 温度</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.vram">VRAM</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.cpu_load">CPU 占用</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.pipeline">FSR、NR 和 FG 状态</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.gpu_times">每个处理阶段的 GPU 时间</sys:String>
  <sys:String x:Key="Str.NrLiveSet.FPS.scale">HUD 大小</sys:String>

</ResourceDictionary>
