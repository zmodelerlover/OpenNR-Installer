<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Arabic. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">معطّل افتراضيًا</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">يحوّل DLSS 4.5 Model M إلى FSR على RDNA 4</sys:String>
  <sys:String x:Key="Str.HostFgLine">توليد الإطارات من danielblnc 0.8.0 في ألعاب D3D12</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">تم العثور على nvngx_dlssd.dll 310.9.1</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">يبني OpenRR شبكته منه</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">لا يوجد nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">غير متوافق</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, تجريبي)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">متوقف ما لم تحدده. تجريبي على RX 7000 ورسوميات RDNA3 / RDNA 3.5: يشغّل OpenRR نوى مصممة لهذه المعالجات (opennr-rr\shaders-gfx11\)، وهو أبطأ منه على RX 9000. إذا لم يبدأ، يذكر ملف opennr_rr.log بجانب اللعبة السبب.</sys:String>
</ResourceDictionary>
