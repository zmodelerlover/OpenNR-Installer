<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- German. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Standardmäßig aus</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">Wandelt DLSS 4.5 Model M in FSR auf RDNA 4 um</sys:String>
  <sys:String x:Key="Str.HostFgLine">Frame-Generation von danielblnc 0.8.0 in D3D12-Spielen</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 gefunden</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR baut sein Netz daraus</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">Keine nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Nicht kompatibel</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, experimentell)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">Aus, solange nicht angehakt. Experimentell auf RX 7000 und RDNA3- / RDNA-3.5-Grafik: OpenRR nutzt dafür gebaute Kernel (opennr-rr\shaders-gfx11\), langsamer als auf einer RX 9000. Startet es nicht, steht der Grund in opennr_rr.log neben dem Spiel.</sys:String>
</ResourceDictionary>
