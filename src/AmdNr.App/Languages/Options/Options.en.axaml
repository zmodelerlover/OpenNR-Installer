<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- The opt-in tiles under the NR runtimes on the OptiScaler route (OptionTile): their chips and short lines, in a file
       of their own beside Strings.en.axaml, which merges it. Every Options.*.axaml has these keys, in this order. -->

  <sys:String x:Key="Str.OffByDefault">Disabled by default</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">WrongGPU by phantoslayer21 · github.com/phantoslayer21/wronggpu</sys:String>
  <sys:String x:Key="Str.HostFgLine">Frame generation from danielblnc 0.8.0 in D3D12 games</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 found</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR builds its network from it</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">No nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Not compatible</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, experimental)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">Off unless ticked. Experimental on RX 7000 and RDNA3 / RDNA 3.5 graphics: OpenRR runs kernels built for these GPUs (opennr-rr\shaders-gfx11\), slower than on an RX 9000. If it does not start, opennr_rr.log beside the game says why.</sys:String>
  <sys:String x:Key="Str.WrongGpuRrToggle">WrongGPU Ray Reconstruction (instead of OpenRR)</sys:String>
  <sys:String x:Key="Str.WrongGpuRrNote">Off unless ticked. WrongGPU's own Ray Reconstruction in this game in place of OpenRR, never both. Its data is converted on this PC from an nvngx_dlssd.dll 310.7 or newer that came with one of your games, never from one this installer put in. In the game turn DLSS Ray Reconstruction on.</sys:String>
  <sys:String x:Key="Str.WrongGpuFetchTitle">Download WrongGPU {0}?</sys:String>
  <sys:String x:Key="Str.WrongGpuFetchBody">WrongGPU converts its model on this PC, with its own launcher, from a DLSS file that came with one of your games. This installer can download WrongGPU-{0}.zip from WrongGPU's official release page on GitHub, check it against the SHA-256 published there, run the conversion and delete the download after. Nothing else is downloaded for it.</sys:String>
  <sys:String x:Key="Str.WrongGpuFetchYes">Download from GitHub and convert</sys:String>
  <sys:String x:Key="Str.WrongGpuFetchNo">Nothing is downloaded</sys:String>
  <sys:String x:Key="Str.WrongGpuDeclined">WrongGPU was not installed: its model has to be converted on this PC first. Leave WrongGPU off to install without it.</sys:String>
  <sys:String x:Key="Str.WrongGpuFetchFailed">WrongGPU could not be downloaded</sys:String>
</ResourceDictionary>
