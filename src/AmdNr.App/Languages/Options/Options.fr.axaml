<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- French. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Désactivé par défaut</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">Convertit le DLSS 4.5 Model M en FSR sur RDNA 4</sys:String>
  <sys:String x:Key="Str.HostFgLine">Génération d'images de danielblnc 0.8.0 dans les jeux D3D12</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 trouvé</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR construit son réseau à partir de lui</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">Pas de nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Non compatible</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, expérimental)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">Désactivé sauf si coché. Expérimental sur RX 7000 et les graphiques RDNA3 / RDNA 3.5 : OpenRR utilise des noyaux faits pour ces GPU (opennr-rr\shaders-gfx11\), plus lent que sur une RX 9000. S'il ne démarre pas, opennr_rr.log à côté du jeu indique pourquoi.</sys:String>
</ResourceDictionary>
