<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Hindi. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">डिफ़ॉल्ट रूप से बंद</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">RDNA 4 पर DLSS 4.5 Model M को FSR में बदलता है</sys:String>
  <sys:String x:Key="Str.HostFgLine">D3D12 गेम्स में danielblnc 0.8.0 का फ़्रेम जनरेशन</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 मिला</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR इससे अपना नेटवर्क बनाता है</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">कोई nvngx_dlssd.dll नहीं</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">संगत नहीं</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, प्रायोगिक)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">टिक करने तक बंद। RX 7000 और RDNA3 / RDNA 3.5 ग्राफ़िक्स पर प्रायोगिक: OpenRR इन GPU के लिए बने कर्नेल (opennr-rr\shaders-gfx11\) चलाता है, RX 9000 से धीमा। अगर यह शुरू न हो, तो गेम के पास opennr_rr.log में कारण लिखा होता है।</sys:String>
</ResourceDictionary>
