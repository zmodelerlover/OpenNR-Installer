<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Italian. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Disattivato di default</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">Converte DLSS 4.5 Model M in FSR su RDNA 4</sys:String>
  <sys:String x:Key="Str.HostFgLine">Generazione di frame di danielblnc 0.8.0 nei giochi D3D12</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 trovato</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR costruisce la sua rete da questo</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">Nessun nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Non compatibile</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, sperimentale)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">Disattivato finché non lo spunti. Sperimentale su RX 7000 e grafica RDNA3 / RDNA 3.5: OpenRR usa kernel fatti per queste GPU (opennr-rr\shaders-gfx11\), più lento che su una RX 9000. Se non parte, opennr_rr.log accanto al gioco dice perché.</sys:String>
</ResourceDictionary>
