<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Lithuanian. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Pagal numatymą išjungta</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">Paverčia DLSS 4.5 Model M į FSR RDNA 4 kortose</sys:String>
  <sys:String x:Key="Str.HostFgLine">danielblnc 0.8.0 kadrų generavimas D3D12 žaidimuose</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">Rastas nvngx_dlssd.dll 310.9.1</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR iš jo kuria savo tinklą</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">Nėra nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Nesuderinama</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, eksperimentinis)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">Išjungta, kol nepažymėsite. Eksperimentinis RX 7000 ir RDNA3 / RDNA 3.5 grafikoje: OpenRR naudoja šiems GPU sukurtus branduolius (opennr-rr\shaders-gfx11\), lėčiau nei RX 9000. Jei nepasileidžia, priežastis nurodyta opennr_rr.log šalia žaidimo.</sys:String>
</ResourceDictionary>
