<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Polish. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Domyślnie wyłączone</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">Zamienia DLSS 4.5 Model M na FSR na RDNA 4</sys:String>
  <sys:String x:Key="Str.HostFgLine">Generowanie klatek z danielblnc 0.8.0 w grach D3D12</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">Znaleziono nvngx_dlssd.dll 310.9.1</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR buduje z niego swoją sieć</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">Brak nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Niezgodne</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, eksperymentalnie)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">Wyłączone, dopóki nie zaznaczysz. Eksperymentalne na RX 7000 i grafice RDNA3 / RDNA 3.5: OpenRR używa kerneli zrobionych dla tych GPU (opennr-rr\shaders-gfx11\), wolniej niż na RX 9000. Jeśli się nie uruchomi, powód jest w opennr_rr.log obok gry.</sys:String>
</ResourceDictionary>
