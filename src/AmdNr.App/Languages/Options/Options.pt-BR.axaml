<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Brazilian Portuguese. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Desativado por padrão</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">Converte DLSS 4.5 Model M p/ FSR em RDNA 4</sys:String>
  <sys:String x:Key="Str.HostFgLine">Geração de quadros do danielblnc 0.8.0 em jogos D3D12</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 encontrado</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">O OpenRR monta a rede a partir dele</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">Sem nvngx_dlssd.dll</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Não compatível</sys:String>
</ResourceDictionary>
