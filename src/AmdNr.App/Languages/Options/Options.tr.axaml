<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Turkish. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Varsayılan olarak kapalı</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">DLSS 4.5 Model M'yi RDNA 4'te FSR'ye çevirir</sys:String>
  <sys:String x:Key="Str.HostFgLine">D3D12 oyunlarında danielblnc 0.8.0 kare üretimi</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 bulundu</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR ağını bundan kurar</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">nvngx_dlssd.dll yok</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Uyumlu değil</sys:String>
  <sys:String x:Key="Str.OpenRrToggleRx7000">OpenRR (Ray Reconstruction, RX 7000, deneysel)</sys:String>
  <sys:String x:Key="Str.OpenRrNoteRx7000">İşaretlenmedikçe kapalı. RX 7000 ve RDNA3 / RDNA 3.5 grafiklerde deneysel: OpenRR bu GPU'lar için yapılmış çekirdekleri kullanır (opennr-rr\shaders-gfx11\), RX 9000'den daha yavaştır. Başlamazsa nedeni oyunun yanındaki opennr_rr.log dosyasında yazar.</sys:String>
</ResourceDictionary>
