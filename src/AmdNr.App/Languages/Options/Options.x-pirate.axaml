<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Pirate. The same keys as Options.en.axaml, in its order. -->

  <sys:String x:Key="Str.OffByDefault">Lashed down by default</sys:String>
  <sys:String x:Key="Str.WrongGpuLine">Turns DLSS 4.5 Model M into FSR on RDNA 4</sys:String>
  <sys:String x:Key="Str.HostFgLine">danielblnc 0.8.0's frame makin' in D3D12 games</sys:String>
  <sys:String x:Key="Str.OpenRrFoundChip">nvngx_dlssd.dll 310.9.1 be found</sys:String>
  <sys:String x:Key="Str.OpenRrFoundLine">OpenRR builds its net from it</sys:String>
  <sys:String x:Key="Str.OpenRrMissingChip">No nvngx_dlssd.dll aboard</sys:String>
  <sys:String x:Key="Str.OpenRrVersionChip">nvngx_dlssd.dll {0}</sys:String>
  <sys:String x:Key="Str.OpenRrBlockedChip">Won't sail</sys:String>
</ResourceDictionary>
