<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmdNr.App.AntiCheatCard">

  <!-- On the sheet of a game whose folder carries an anti-cheat (AntiCheat.Find): what an install risks, and
       NRLive as the way that installs nothing. A warning, not a gate: Install stays where it is. -->
  <Border Classes="callout">
    <Grid ColumnDefinitions="Auto,*">
      <PathIcon Data="{StaticResource IconShield}" Width="18" Height="18" Foreground="{DynamicResource Warn}"
                VerticalAlignment="Top" Margin="0,1,11,0" />
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock x:Name="Title" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" />
        <TextBlock Text="{DynamicResource Str.AntiCheatBody}" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{DynamicResource WarnText}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button x:Name="UseButton" Classes="primary small" Click="OnUse" AutomationProperties.Name="{DynamicResource Str.AntiCheatUse}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconScale}" Width="14" Height="14" />
              <TextBlock Text="{DynamicResource Str.AntiCheatUse}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="IgnoreButton" Classes="ghost small" Click="OnIgnore" Content="{DynamicResource Str.AntiCheatIgnore}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
